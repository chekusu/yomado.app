      "cues": [
        {
          "key": "en01",
          "section": "need",
          "start": 0.5,
          "end": 2.58,
          "text": "Some work needs a screen."
        },
        {
          "key": "en02",
          "section": "need",
          "start": 2.58,
          "end": 4.862,
          "text": "Like Blender, or Marvelous Designer."
        },
        {
          "key": "en03",
          "section": "create",
          "start": 8.05,
          "end": 10.77,
          "text": "Give your agent a dedicated work screen."
        },
        {
          "key": "en04",
          "section": "create",
          "start": 10.77,
          "end": 13.09,
          "text": "Create a virtual display with yomado,"
        },
        {
          "key": "en05",
          "section": "create",
          "start": 13.09,
          "end": 14.581,
          "text": "and name it Codex."
        },
        {
          "key": "en06",
          "section": "move",
          "start": 19.45,
          "end": 21.53,
          "text": "Drag in the apps it needs."
        },
        {
          "key": "en07",
          "section": "move",
          "start": 21.53,
          "end": 24.01,
          "text": "Blender. Marvelous Designer."
        },
        {
          "key": "en08",
          "section": "move",
          "start": 24.01,
          "end": 25.981,
          "text": "Your other windows stay where they are."
        },
        {
          "key": "en09",
          "section": "operate",
          "start": 31.5,
          "end": 33.42,
          "text": "The agent reads screenshots,"
        },
        {
          "key": "en10",
          "section": "operate",
          "start": 33.42,
          "end": 35.5,
          "text": "clicks controls, and types."
        },
        {
          "key": "en11",
          "section": "operate",
          "start": 35.5,
          "end": 37.14,
          "text": "It works through the interface,"
        },
        {
          "key": "en12",
          "section": "operate",
          "start": 37.14,
          "end": 40.094,
          "text": "even without an app-specific MCP integration."
        },
        {
          "key": "en13",
          "section": "return",
          "start": 44,
          "end": 46.16,
          "text": "Add another screen for GrokBot."
        },
        {
          "key": "en14",
          "section": "return",
          "start": 46.16,
          "end": 48.04,
          "text": "Bring apps back when you need them,"
        },
        {
          "key": "en15",
          "section": "return",
          "start": 48.04,
          "end": 49.329,
          "text": "then close the screen."
        },
        {
          "key": "en16",
          "section": "close",
          "start": 54.4,
          "end": 56.88,
          "text": "yomado. For visual agents."
        },
        {
          "key": "en17",
          "section": "close",
          "start": 56.88,
          "end": 58.919,
          "text": "Download at yomado.app.",
          "said": "Download at yomado dot app."
        }
      ]
    },
    "zh": {
      "narration": "zh-CN",
      "cues": [
        {
          "key": "zh01",
          "section": "need",
          "start": 0.5,
          "end": 3.22,
          "text": "有些工作，得看着界面来做。"
        },
        {
          "key": "zh02",
          "section": "need",
          "start": 3.22,
          "end": 5.646,
          "text": "比如 Blender，或者 MD。"
        },
        {
          "key": "zh03",
          "section": "create",
          "start": 8.05,
          "end": 11.01,
          "text": "用 yomado 新建一块虚拟屏，"
        },
        {
          "key": "zh04",
          "section": "create",
          "start": 11.01,
          "end": 12.45,
          "text": "取名 Codex。"
        },
        {
          "key": "zh05",
          "section": "create",
          "start": 12.45,
          "end": 14.737,
          "text": "给 Agent 一块专用的工作屏。"
        },
        {
          "key": "zh06",
          "section": "move",
          "start": 19.45,
          "end": 22.01,
          "text": "把它需要的应用拖进去。"
        },
        {
          "key": "zh07",
          "section": "move",
          "start": 22.01,
          "end": 24.17,
          "text": "Blender，MD。"
        },
        {
          "key": "zh08",
          "section": "move",
          "start": 24.17,
          "end": 26.09,
          "text": "你自己打开的其他窗口，"
        },
        {
          "key": "zh09",
          "section": "move",
          "start": 26.09,
          "end": 27.574,
          "text": "留在原来的位置。"
        },
        {
          "key": "zh10",
          "section": "operate",
          "start": 31.5,
          "end": 35.26,
          "text": "Agent 看截图、点控件、输入文字。"
        },
        {
          "key": "zh11",
          "section": "operate",
          "start": 35.26,
          "end": 37.1,
          "text": "应用没有专门的 MCP，"
        },
        {
          "key": "zh12",
          "section": "operate",
          "start": 37.1,
          "end": 38.893,
          "text": "也能通过视觉来操作。"
        },
        {
          "key": "zh13",
          "section": "return",
          "start": 44,
          "end": 46.08,
          "text": "再给 GrokBot 一块屏。"
        },
        {
          "key": "zh14",
          "section": "return",
          "start": 46.08,
          "end": 48.24,
          "text": "需要时，把应用拖回来，"
        },
        {
          "key": "zh15",
          "section": "return",
          "start": 48.24,
          "end": 50.531,
          "text": "用完再关掉对应的虚拟屏。"
        },
        {
          "key": "zh16",
          "section": "close",
          "start": 54.4,
          "end": 56.56,
          "text": "yomado，夜窗。"
        },
        {
          "key": "zh17",
          "section": "close",
          "start": 56.56,
          "end": 57.718,
          "text": "去官网下载。"
        }
      ]
