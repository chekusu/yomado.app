{
  "name": "yomado.dev",
  "version": "0.1.0",
  "private": true,
  "description": "Website for yomado, a macOS virtual display for visual agents. The app lives at github.com/chekusu/yomado.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "verify": "node scripts/verify-dist.mjs",
    "test": "node tests/smoke.mjs",
    "test:download": "node tests/download.mjs",
    "preview": "astro preview",
    "build:sub": "SITE_NOINDEX=1 SITE_OUT_DIR=./dist-sub astro build",
    "preview:sub": "npm run build:sub && SITE_OUT_DIR=./dist-sub astro preview --host ${HOST:-127.0.0.1} --port ${PORT:-4321} --allowed-hosts ${PREVIEW_ALLOWED_HOSTS:-localhost}",
    "assets": "node scripts/render-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.5",
    "playwright": "^1.64.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0"
  }
}
