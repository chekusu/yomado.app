---
import Base from '../layouts/Base.astro';
import Brand from '../components/Brand.astro';
import { copyFor } from '../i18n';
import { LOCALES, LOCALE_DIR, LOCALE_TAG, RELEASE, localeHref, withBase } from '../lib/site';

// One page for every address: English, then the way home in each other language, in its own words.
const en = copyFor('en');
const others = LOCALES.filter((l) => l !== 'en').map((l) => ({ tag: LOCALE_TAG[l], dir: LOCALE_DIR(l), href: localeHref(l), copy: copyFor(l) }));
---

<Base locale="en" title={en.notFound.meta} description={en.meta.description} path="404/" ogAlt={en.meta.ogAlt} localized={false} noindex>
  <main class="not-found night wrap">
    <a class="home" href={withBase()} aria-label={en.nav.home}><Brand size={44} /></a>
    <h1 class="headline">{en.notFound.title}</h1>
    <p class="sub">{en.notFound.text}</p>
    <div class="actions">
      <a class="btn btn-ivory" href={localeHref('en')}>{en.notFound.home}</a>
      <a class="more" href={RELEASE.url}>{en.hero.cta}</a>
    </div>
    <ul class="others">
      {
        others.map(({ tag, dir, href, copy }) => (
          <li>
            <a href={href} hreflang={tag} lang={tag} dir={dir}>
              {copy.notFound.home}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style is:global>
  body:has(.not-found) {
    background: var(--night-950);
  }
</style>

<style>
  .not-found {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 18px;
    min-height: 100vh;
    padding-block: 64px;
    text-align: center;
  }

  .home {
    margin-bottom: 20px;
    color: var(--ink);
    text-decoration: none;
  }

  .sub {
    max-width: 34ch;
  }

  .actions {
    margin-top: 16px;
  }

  .others {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 22px;
    max-width: 46rem;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }
</style>
