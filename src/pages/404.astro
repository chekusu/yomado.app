---
import Base from '../layouts/Base.astro';
import Brand from '../components/Brand.astro';
import { copyFor } from '../i18n';
import { RELEASE, withBase } from '../lib/site';

const en = copyFor('en');
const zh = copyFor('zh-cn');
---

<Base locale="en" title={en.notFound.meta} description={en.meta.description} path="404/" ogAlt={en.meta.ogAlt} localized={false} noindex>
  <main class="not-found night wrap">
    <a class="home" href={withBase()} aria-label={en.nav.home}><Brand size={44} /></a>
    <h1 class="headline">{en.notFound.title}</h1>
    <p class="sub">{en.notFound.text}</p>
    <p class="sub" lang="zh-CN">{zh.notFound.title} {zh.notFound.text}</p>
    <div class="actions">
      <a class="btn btn-ivory" href={withBase()}>{en.notFound.home}</a>
      <a class="more" href={withBase('zh-cn/')} lang="zh-CN">{zh.notFound.home}</a>
      <a class="more" href={RELEASE.url}>{en.hero.cta}</a>
    </div>
  </main>
</Base>

<style is:global>
  body:has(.not-found) {
    background: var(--night-950);
  }
</style>

<style>
  .not-found {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 18px;
    min-height: 100vh;
    padding-block: 64px;
    text-align: center;
  }

  .home {
    margin-bottom: 20px;
    color: var(--ink);
    text-decoration: none;
  }

  .sub {
    max-width: 34ch;
  }

  .actions {
    margin-top: 16px;
  }
</style>
