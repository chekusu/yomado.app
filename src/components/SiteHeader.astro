---
import Brand from './Brand.astro';
import { LOCALES, LOCALE_NAME, LOCALE_PATH, LOCALE_TAG, RELEASE, localeHref, withBase, type Locale } from '../lib/site';
import type { Copy } from '../i18n';

interface Props {
  locale: Locale;
  copy: Copy;
  /** This page's path below each locale's root: '' for home, 'details/' for the details page. */
  route?: string;
}

const { locale, copy, route = '' } = Astro.props;
const onDetails = route === 'details/';
---

<header class="site-header" data-header>
  <div class="bar wrap">
    <a class="home" href={localeHref(locale)} aria-label={copy.nav.home}>
      <Brand size={26} />
    </a>
    <nav aria-label={copy.nav.label}>
      <a class="nav-link details" href={withBase(`${LOCALE_PATH[locale]}details/`)} aria-current={onDetails ? 'page' : undefined}>
        {copy.nav.details}
      </a>
      <!-- A native disclosure: it opens without JavaScript; page.ts closes it on Escape or an outside click. -->
      <details class="langs" data-lang-menu>
        <summary class="nav-link">
          <span class="visually-hidden">{copy.nav.language}: </span>
          <span lang={LOCALE_TAG[locale]}>{LOCALE_NAME[locale].short}</span>
          <svg class="chevron" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" /></svg>
        </summary>
        <ul class="menu">
          {
            LOCALES.map((l) => (
              <li>
                <a
                  href={localeHref(l, route)}
                  hreflang={LOCALE_TAG[l]}
                  lang={LOCALE_TAG[l]}
                  aria-current={l === locale ? 'page' : undefined}
                  data-lang-switch
                  data-locale={l}
                >
                  {LOCALE_NAME[l].full}
                  {l === locale && (
                    <svg class="check" viewBox="0 0 12 9" width="12" height="9" aria-hidden="true">
                      <path d="M1 4.5l3.4 3.4L11 1.2" />
                    </svg>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <a class="get" href={RELEASE.url} data-download="header">{copy.nav.download}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header);
    background: rgb(255 255 255 / 0.78);
    border-bottom: 1px solid rgb(0 0 0 / 0.08);
    color: var(--ink);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    transition:
      background-color 400ms var(--ease),
      border-color 400ms var(--ease),
      color 400ms var(--ease);
  }

  .site-header[data-tone='night'] {
    --ink-2: #9aa3c4;
    background: rgb(5 10 28 / 0.72);
    border-color: rgb(255 255 255 / 0.08);
    color: #f5f5f7;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 100%;
  }

  .home {
    display: flex;
    flex: none;
    color: inherit;
    text-decoration: none;
    border-radius: 8px;
  }

  nav {
    display: flex;
    flex: none;
    align-items: center;
    gap: clamp(14px, 2.4vw, 28px);
    white-space: nowrap;
  }

  .nav-link {
    color: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    opacity: 0.82;
    text-decoration: none;
    transition: opacity 200ms var(--ease);
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    opacity: 1;
  }

  /* Language menu: the current language in the bar, all three by their own names below it. */
  .langs {
    position: relative;
  }

  .langs summary {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border-radius: 6px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .langs summary::-webkit-details-marker {
    display: none;
  }

  .langs[open] summary {
    opacity: 1;
  }

  .chevron {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 200ms var(--ease);
  }

  .langs[open] .chevron {
    transform: rotate(180deg);
  }

  .menu {
    position: absolute;
    top: calc(100% + 14px);
    right: -10px;
    z-index: 60;
    display: grid;
    min-width: 10rem;
    margin: 0;
    padding: 6px;
    list-style: none;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.98);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.08),
      0 14px 34px -10px rgb(10 21 56 / 0.3);
    color: var(--ink);
  }

  .menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 8px 10px;
    border-radius: 8px;
    color: inherit;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .menu a:hover {
    background: rgb(0 0 0 / 0.05);
  }

  .menu a[aria-current='page'] {
    font-weight: 600;
  }

  .check {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  [data-tone='night'] .menu {
    background: rgb(16 24 56 / 0.98);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.12),
      0 14px 34px -10px rgb(0 0 0 / 0.5);
    color: #f5f5f7;
  }

  [data-tone='night'] .menu a:hover {
    background: rgb(255 255 255 / 0.08);
  }

  .get {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 13px;
    border-radius: 999px;
    background: var(--night-800);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 300ms var(--ease),
      color 300ms var(--ease);
  }

  .get:hover {
    background: var(--night-700);
  }

  [data-tone='night'] .get {
    background: var(--ivory);
    color: var(--night-900);
  }

  /* Phones: one line, always. 夜窗 and Details step back first. */
  @media (max-width: 520px) {
    .details {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .site-header :global(.kanji) {
      display: none;
    }

    nav {
      gap: 14px;
    }
  }

  @media (max-width: 360px) {
    .bar {
      gap: 10px;
    }

    nav {
      gap: 12px;
    }

    .get {
      padding: 0 11px;
    }
  }
</style>
