---
import { phrased } from '../lib/text';
import type { Copy } from '../i18n';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
---

<section class="faq wrap" id="faq" aria-labelledby="faq-title">
  <header>
    <p class="kicker">{copy.faq.kicker}</p>
    <h2 id="faq-title" class="display" set:html={phrased(copy.faq.title)} />
  </header>
  <div class="items">
    {
      copy.faq.items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p set:html={item.aHtml} />
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(28px, 6vw, 96px);
    padding-block: clamp(40px, 6vw, 80px) clamp(80px, 11vw, 150px);
  }

  header {
    align-self: start;
    position: sticky;
    top: 32px;
  }

  .items {
    border-top: 1px solid rgb(252 248 225 / 0.14);
  }

  details {
    border-bottom: 1px solid rgb(252 248 225 / 0.14);
  }

  summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding-block: 20px;
    color: var(--ivory-100);
    font-size: 1.0625rem;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    flex: none;
    color: var(--mist-400);
    font: 300 1.5rem/1 var(--font-display);
    transition: transform 240ms var(--ease);
  }

  details[open] summary::after {
    transform: rotate(45deg);
  }

  summary:hover {
    color: var(--ivory-50);
  }

  details p {
    max-width: 58ch;
    padding-bottom: 22px;
    color: var(--mist-300);
  }

  details p :global(a) {
    color: var(--mist-200);
  }

  @media (max-width: 860px) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
    }

    header {
      position: static;
    }
  }
</style>
