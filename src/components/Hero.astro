---
import Brand from './Brand.astro';
import Film from './Film.astro';
import Icon from './Icon.astro';
import { RELEASE } from '../lib/site';
import { phrased } from '../lib/text';
import type { Copy } from '../i18n';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="copy wrap">
    <p class="brand"><Brand size={40} /></p>
    <h1 id="hero-title" class="headline" set:html={phrased(copy.hero.title)} />
    <p class="sub">{copy.hero.sub}</p>
    <div class="actions">
      <a class="btn btn-night" href={RELEASE.url} data-download="hero"><Icon name="download" size={18} />{copy.hero.cta}</a>
    </div>
    <p class="fine">{copy.hero.meta}</p>
  </div>
  <Film copy={copy} />
</section>

<style>
  .hero {
    padding-block: clamp(28px, 4.5vh, 56px) clamp(56px, 9vh, 112px);
    background: #fff;
  }

  .copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 12px;
    margin-bottom: clamp(18px, 3vh, 36px);
    text-align: center;
  }

  .brand {
    margin: 0 0 4px;
    color: var(--ink);
  }

  .sub {
    max-width: 30ch;
  }

  :lang(zh-CN) .sub,
  :lang(ja) .sub {
    max-width: 22em;
  }

  .actions {
    margin-top: 10px;
  }

  .fine {
    margin-top: -2px;
  }
</style>
