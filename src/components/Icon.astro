---
interface Props {
  name: 'download' | 'replay' | 'play' | 'pause';
  size?: number;
}

const { name, size = 20 } = Astro.props;
---

{
  name === 'download' && (
    <svg width={size} height={size} viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 2.75v10M6.25 9.25 10 13l3.75-3.75M3.75 13.5v1.75c0 .83.67 1.5 1.5 1.5h9.5c.83 0 1.5-.67 1.5-1.5V13.5" />
    </svg>
  )
}
{
  name === 'replay' && (
    <svg width={size} height={size} viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4.25 10a5.75 5.75 0 1 0 1.9-4.28M4 3.5v3.25h3.25" />
    </svg>
  )
}
{
  name === 'play' && (
    <svg width={size} height={size} viewBox="0 0 20 20" aria-hidden="true" fill="currentColor">
      <path d="M6.5 4.6v10.8c0 .7.77 1.13 1.37.76l8.6-5.4a.9.9 0 0 0 0-1.52l-8.6-5.4c-.6-.37-1.37.06-1.37.76Z" />
    </svg>
  )
}
{
  name === 'pause' && (
    <svg width={size} height={size} viewBox="0 0 20 20" aria-hidden="true" fill="currentColor">
      <rect x="5" y="4" width="3.6" height="12" rx="1.1" />
      <rect x="11.4" y="4" width="3.6" height="12" rx="1.1" />
    </svg>
  )
}
