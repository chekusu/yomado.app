---
// The concept film, rendered from the story timeline (scripts/render-film.mjs). Muted and inline;
// it starts after the page has loaded and while it is in view, never under reduced motion.
// Without JavaScript the browser's own controls appear instead of the play/pause button.
import Icon from './Icon.astro';
import { withBase } from '../lib/site';
import type { Copy } from '../i18n';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const film = copy.hero.film;
const media = (file: string) => withBase(`media/${file}`);
// H.264 High profile; VP9 for browsers built without H.264.
const MP4 = 'video/mp4; codecs="avc1.640028"';
const WEBM = 'video/webm; codecs="vp9"';
const NARROW = '(max-width: 640px)';
---

<figure class="film" data-film>
  <div class="frame">
    <video
      class="video"
      muted
      playsinline
      controls
      preload="none"
      poster={media('film-wide-poster.webp')}
      data-poster-narrow={media('film-tall-poster.webp')}
      data-narrow={NARROW}
      aria-label={film.label}
    >
      <source src={media('film-tall.mp4')} type={MP4} media={NARROW} />
      <source src={media('film-tall.webm')} type={WEBM} media={NARROW} />
      <source src={media('film-wide.mp4')} type={MP4} />
      <source src={media('film-wide.webm')} type={WEBM} />
      <p>{film.fallback} <a href={media('film-wide.mp4')}>MP4</a></p>
    </video>
    <button
      class="toggle"
      type="button"
      hidden
      data-film-toggle
      data-state="paused"
      aria-label={film.play}
      data-label-play={film.play}
      data-label-pause={film.pause}
      data-label-replay={film.replay}
    >
      <span class="i-play"><Icon name="play" size={18} /></span>
      <span class="i-pause"><Icon name="pause" size={18} /></span>
      <span class="i-replay"><Icon name="replay" size={18} /></span>
    </button>
  </div>
  <figcaption class="fine caption">{film.caption}</figcaption>
</figure>

<style>
  .film {
    width: min(100% - 2 * var(--gutter), 1280px);
    margin: 0 auto;
  }

  .frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: clamp(18px, 2.4vw, 32px);
    background: #fff;
    isolation: isolate;
  }

  .video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #fff;
  }

  .toggle {
    position: absolute;
    right: clamp(12px, 2vw, 22px);
    bottom: clamp(12px, 2vw, 22px);
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(232 232 237 / 0.82);
    color: #1d1d1f;
    cursor: pointer;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition:
      background-color 200ms var(--ease),
      transform 200ms var(--ease);
  }

  .toggle:hover {
    background: rgb(255 255 255 / 0.95);
  }

  .toggle:active {
    transform: scale(0.94);
  }

  .toggle > span {
    display: none;
  }

  .toggle[data-state='paused'] .i-play,
  .toggle[data-state='playing'] .i-pause,
  .toggle[data-state='ended'] .i-replay {
    display: grid;
  }

  .caption {
    margin-top: 14px;
    text-align: center;
  }

  @media (max-width: 640px) {
    .frame {
      aspect-ratio: 4 / 5;
    }
  }
</style>
