---
// The one-minute product film in this page's language (src/lib/media.ts), rendered from its own
// timeline (src/lib/film.ts) and narrated (English or Simplified Chinese; the Japanese film has
// the English narration and its sound button says so). It starts muted and inline after the page
// has loaded and while it is in view, never under reduced motion; the sound button turns the
// narration on (src/scripts/film.ts). Subtitles in 16 languages (src/lib/captions.ts) show under
// the film, never over it; a language that follows the other narration brings its own film. Without
// JavaScript the browser's own controls appear instead of our buttons, there are no subtitles, and
// nothing is muted: a film someone starts plays with its sound. The watch page plays it with full
// controls.
import Icon from './Icon.astro';
import { CAPTION_LOCALES, captionGroups, filmConfig, PAGE_NARRATION } from '../lib/captions';
import { MP4_TYPE, NARROW, WEBM_TYPE, filmUrl, posterUrl } from '../lib/media';
import { localeHref, type Locale } from '../lib/site';
import type { Copy } from '../i18n';

interface Props {
  locale: Locale;
  copy: Copy;
}

const { locale, copy } = Astro.props;
const film = copy.hero.film;
const narration = PAGE_NARRATION[locale];
const label = film.label.replace('{narration}', film.narration[narration]);
---

<figure class="film" data-film>
  <div class="frame">
    <video
      class="video"
      playsinline
      controls
      preload="none"
      poster={posterUrl(locale, 'wide')}
      data-poster-narrow={posterUrl(locale, 'tall')}
      data-narrow={NARROW}
      aria-label={label}
    >
      <source src={filmUrl(locale, 'tall', 'mp4')} type={MP4_TYPE} media={NARROW} />
      <source src={filmUrl(locale, 'tall', 'webm')} type={WEBM_TYPE} media={NARROW} />
      <source src={filmUrl(locale, 'wide', 'mp4')} type={MP4_TYPE} />
      <source src={filmUrl(locale, 'wide', 'webm')} type={WEBM_TYPE} />
      <p>{film.fallback} <a href={filmUrl(locale, 'wide', 'mp4')}>MP4</a></p>
    </video>
    <div class="controls">
      <label class="cc" hidden data-film-cc>
        <Icon name="captions" size={18} />
        <span class="text" data-film-cc-text></span>
        <select data-film-cc-select aria-label={film.captions}>
          <option value="off">{film.captionsOff}</option>
          {
            captionGroups(locale).map((group) => (
              <optgroup label={film.narration[group.narration]}>
                {group.tags.map((tag) => (
                  <option value={tag} lang={tag}>
                    {CAPTION_LOCALES[tag].name}
                  </option>
                ))}
              </optgroup>
            ))
          }
        </select>
      </label>
      <button
        class="sound"
        type="button"
        hidden
        data-film-sound
        data-state="muted"
        aria-label={film.soundOn[narration]}
        data-label-off={film.mute}
        data-text-off={film.mute}
      >
        <span class="i-on"><Icon name="sound" size={18} /></span>
        <span class="i-off"><Icon name="muted" size={18} /></span>
        <span class="text" data-film-sound-text>{film.soundOnText[narration]}</span>
      </button>
      <button
        class="toggle"
        type="button"
        hidden
        data-film-toggle
        data-state="paused"
        aria-label={film.play}
        data-label-play={film.play}
        data-label-pause={film.pause}
        data-label-replay={film.replay}
      >
        <span class="i-play"><Icon name="play" size={18} /></span>
        <span class="i-pause"><Icon name="pause" size={18} /></span>
        <span class="i-replay"><Icon name="replay" size={18} /></span>
      </button>
    </div>
  </div>
  <p class="subtitle" hidden data-film-subtitle></p>
  <figcaption class="fine caption">
    <span><span data-film-narration>{film.narrationNote[narration]}</span>{locale === 'en' ? ' ' : ''}{film.caption}</span>
    <a class="more watch" href={localeHref(locale, 'watch/')} data-watch-link>{film.watch}</a>
  </figcaption>
  <script is:inline type="application/json" data-film-config set:html={JSON.stringify(filmConfig(locale, copy)).replace(/</g, '\\u003c')} />
</figure>

<style>
  .film {
    width: min(100% - 2 * var(--gutter), 1280px);
    margin: 0 auto;
  }

  .frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: clamp(18px, 2.4vw, 32px);
    background: #fff;
    isolation: isolate;
  }

  .video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #fff;
  }

  /* Sound, then play/pause, in the corner: one row of frosted controls. */
  .controls {
    position: absolute;
    right: clamp(12px, 2vw, 22px);
    bottom: clamp(12px, 2vw, 22px);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .toggle {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(232 232 237 / 0.82);
    color: #1d1d1f;
    cursor: pointer;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition:
      background-color 200ms var(--ease),
      transform 200ms var(--ease);
  }

  .toggle:hover,
  .sound:hover {
    background: rgb(255 255 255 / 0.95);
  }

  .toggle:active {
    transform: scale(0.94);
  }

  /* A labelled pill: the action's icon and its name, as short as each language allows. */
  .sound {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 15px 0 12px;
    border: 0;
    border-radius: 999px;
    background: rgb(232 232 237 / 0.82);
    color: #1d1d1f;
    font: 600 0.875rem/1 var(--font-sans);
    letter-spacing: -0.01em;
    white-space: nowrap;
    cursor: pointer;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition:
      background-color 200ms var(--ease),
      transform 200ms var(--ease);
  }

  .sound:active {
    transform: scale(0.97);
  }

  .sound > span:not(.text) {
    display: none;
  }

  .sound[data-state='muted'] .i-on,
  .sound[data-state='on'] .i-off {
    display: grid;
  }

  /* Subtitles: a pill with the current language; the native select over it does the choosing. */
  .cc {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 14px 0 11px;
    border-radius: 999px;
    background: rgb(232 232 237 / 0.82);
    color: #1d1d1f;
    font: 600 0.875rem/1 var(--font-sans);
    letter-spacing: -0.01em;
    white-space: nowrap;
    cursor: pointer;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition: background-color 200ms var(--ease);
  }

  .cc:hover {
    background: rgb(255 255 255 / 0.95);
  }

  .cc[data-state='off'] :global(svg) {
    opacity: 0.55;
  }

  .cc select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    font-size: 16px;
    cursor: pointer;
  }

  .cc:has(select:focus-visible) {
    outline: 3px solid #4d7cff;
    outline-offset: 3px;
  }

  /* Until the script takes over (or when nothing can play) the buttons stay out of sight. */
  .toggle[hidden],
  .sound[hidden],
  .cc[hidden] {
    display: none;
  }

  /* The subtitle line under the film: never over the picture. Two lines are kept so the page
     doesn't move between cues. */
  .subtitle {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(2 * 1.4em + 12px);
    margin: 10px auto 0;
    max-width: 46em;
    padding: 0 var(--gutter);
    color: var(--ink);
    font-size: clamp(1rem, 0.9rem + 0.35vw, 1.1875rem);
    font-weight: 500;
    line-height: 1.4;
    text-align: center;
    text-wrap: balance;
    white-space: pre-line;
  }

  .subtitle[hidden] {
    display: none;
  }

  .subtitle:lang(ko) {
    word-break: keep-all;
  }

  .subtitle:lang(ja) {
    word-break: auto-phrase;
  }

  .toggle > span {
    display: none;
  }

  .toggle[data-state='paused'] .i-play,
  .toggle[data-state='playing'] .i-pause,
  .toggle[data-state='ended'] .i-replay {
    display: grid;
  }

  .caption {
    display: grid;
    justify-items: center;
    gap: 6px;
    margin-top: 14px;
    text-align: center;
  }

  @media (max-width: 640px) {
    .frame {
      aspect-ratio: 4 / 5;
    }
  }
</style>
