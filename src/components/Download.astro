---
import Icon from './Icon.astro';
import { RELEASE, SITE } from '../lib/site';
import type { Copy } from '../i18n';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
---

<section class="download wrap" id="download" aria-labelledby="download-title">
  <div class="glow">
    <div class="card lit window-shape">
      <div class="main">
        <p class="kicker">{copy.download.kicker}</p>
        <h2 id="download-title" class="display">{copy.download.title}</h2>
        <p class="lede">{copy.download.lede}</p>
        <a class="btn btn-night btn-download" href={RELEASE.url} data-download="section">
          <Icon name="download" size={22} />
          <span class="btn-text">
            <span class="btn-label">{copy.download.cta}</span>
            <span class="btn-meta">{copy.download.ctaMeta}</span>
          </span>
        </a>
        <p class="links">
          <a href={RELEASE.notesUrl}>{copy.download.notes}</a>
          <a href={RELEASE.checksumsUrl}>{copy.download.checksums}</a>
          <a href={SITE.appRepository}>{copy.download.source}</a>
        </p>
      </div>

      <dl class="specs">
        {
          copy.download.specs.map((spec) => (
            <div>
              <dt>{spec.term}</dt>
              <dd>{spec.value}</dd>
            </div>
          ))
        }
        <div class="hash">
          <dt>{copy.download.hashLabel}</dt>
          <dd>
            <code id="release-sha256">{RELEASE.sha256}</code>
            <button
              type="button"
              class="copy"
              data-copy="#release-sha256"
              data-copied={copy.download.copied}
              data-fallback={copy.download.copyFallback}
            >
              {copy.download.copy}
            </button>
            <span class="visually-hidden" aria-live="polite" data-copy-status></span>
          </dd>
        </div>
      </dl>

      <div class="first-run">
        <h3>{copy.download.firstRunTitle}</h3>
        <ol>
          {copy.download.firstRunHtml.map((item) => <li set:html={item} />)}
        </ol>
      </div>

      <div class="verify">
        <h3>{copy.download.verifyTitle}</h3>
        <pre><code>shasum -a 256 {RELEASE.fileName}</code></pre>
      </div>
    </div>
  </div>
</section>

<style>
  .download {
    padding-block: clamp(40px, 6vw, 80px) clamp(72px, 10vw, 140px);
  }

  .glow {
    filter: drop-shadow(0 0 60px rgb(252 248 225 / 0.16));
  }

  .card {
    --r: clamp(46px, 7vw, 92px);
    --tl: clamp(36px, 6vw, 84px);
    --br: clamp(14px, 2vw, 22px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(32px, 5vw, 72px) clamp(28px, 5vw, 80px);
    padding: clamp(40px, 6vw, 80px) clamp(24px, 5vw, 72px);
  }

  .main .lede {
    max-width: 26rem;
    margin-top: 18px;
    color: var(--ink-soft);
  }

  .btn-download {
    min-height: 64px;
    margin-top: 30px;
    padding: 10px 28px 10px 22px;
    border-radius: 20px;
  }

  .btn-text {
    display: grid;
    gap: 3px;
    text-align: left;
  }

  .btn-label {
    font-size: 1.0625rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 22px;
    font-size: 0.9375rem;
  }

  .links a {
    color: var(--ink-soft);
  }

  .specs {
    align-self: start;
    padding-right: calc(var(--r) * 1.2);
    border-top: 1px solid rgb(12 25 64 / 0.16);
  }

  .specs > div {
    display: grid;
    grid-template-columns: minmax(6.5rem, 0.32fr) 1fr;
    gap: 4px 18px;
    padding-block: 12px;
    border-bottom: 1px solid rgb(12 25 64 / 0.16);
  }

  dt {
    color: var(--ink-faint);
    font: 400 0.8125rem/1.6 var(--font-mono);
    letter-spacing: 0.04em;
  }

  dd {
    color: var(--ink);
    font-size: 0.9375rem;
  }

  .hash dd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }

  .hash code {
    min-width: 0;
    flex: 1 1 18rem;
    font-size: 0.8rem;
    line-height: 1.5;
    word-break: break-all;
  }

  .copy {
    padding: 5px 12px;
    border: 1px solid rgb(12 25 64 / 0.3);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: 400 0.8125rem/1.2 var(--font-mono);
    cursor: pointer;
  }

  .copy:hover {
    border-color: var(--ink);
  }

  h3 {
    margin-bottom: 12px;
    color: var(--ink-faint);
    font: 400 0.8125rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .first-run ol {
    display: grid;
    gap: 8px;
    padding-left: 1.3em;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .first-run li::marker {
    color: var(--ink-faint);
    font-family: var(--font-mono);
  }

  .first-run :global(strong) {
    color: var(--ink);
  }

  pre {
    margin: 0;
    padding: 14px 16px;
    overflow-x: auto;
    border-radius: 12px;
    background: var(--ink);
    color: var(--ivory-100);
    font-size: 0.875rem;
  }

  @media (max-width: 860px) {
    .card {
      grid-template-columns: minmax(0, 1fr);
    }

    .specs {
      padding-right: 0;
    }
  }

  @media (max-width: 520px) {
    .btn-download {
      width: 100%;
      justify-content: flex-start;
    }

    .specs > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
