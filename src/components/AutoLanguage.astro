---
// The bare home page speaks the visitor's language. Rendered only on the English home page and as
// early in <head> as possible, so a browser in another of the 16 languages moves on before English
// paints.
//
// Order: a valid ?lang= in the address (read like a browser language: ?lang=pt-BR, ?lang=zh-Hant),
// then a language picked by hand from the menu or footer
// (stored by src/scripts/page.ts), then the first supported entry of navigator.languages
// (navigator.language only when that list is empty), then English. Chinese goes by script, then
// region: Traditional (zh-Hant, or zh-TW, zh-HK, zh-MO) to 繁體中文, any other zh to 简体中文; any
// Portuguese (pt-PT too) to Português (Brasil); the rest by their primary language. Detection
// stores nothing. Every other page, in any language, never redirects, so there is no loop; without
// JavaScript the English page simply stays.
import { LANGUAGE_KEY } from '../lib/language';
import { LOCALE_PATH, withBase } from '../lib/site';

const base = withBase();
---

<script is:inline define:vars={{ base, paths: LOCALE_PATH, key: LANGUAGE_KEY }}>
  (function () {
    var here = location.pathname;
    if (here !== base && here !== base + 'index.html') return;
    var known = function (value) {
      return value && Object.prototype.hasOwnProperty.call(paths, value) ? value : null;
    };
    var fromTag = function (tag) {
      var parts = String(tag || '').toLowerCase().split(/[-_]/);
      if (parts[0] === 'zh') {
        if (parts.indexOf('hant') > 0) return 'zh-tw';
        if (parts.indexOf('hans') > 0) return 'zh-cn';
        return /^(tw|hk|mo)$/.test(parts[1] || '') ? 'zh-tw' : 'zh-cn';
      }
      if (parts[0] === 'pt') return 'pt-br';
      return known(parts[0]);
    };
    var asked = new URLSearchParams(location.search).get('lang');
    var choice = asked ? fromTag(asked) : null;
    if (!choice) {
      try {
        choice = known(localStorage.getItem(key));
      } catch (e) {
        // Storage may be off; the browser's languages still decide.
      }
    }
    if (!choice) {
      var tags = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language];
      for (var i = 0; i < tags.length && !choice; i++) choice = fromTag(tags[i]);
    }
    if (!choice || choice === 'en') return;
    // Keep the English page from flashing while the browser moves on; show it if that stalls.
    var root = document.documentElement;
    root.style.visibility = 'hidden';
    setTimeout(function () {
      root.style.visibility = '';
    }, 3000);
    location.replace(base + paths[choice] + location.search + location.hash);
  })();
</script>
