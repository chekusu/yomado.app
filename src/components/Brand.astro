---
// The night-window app icon with the lowercase wordmark and 夜窗.
import { Image } from 'astro:assets';
import icon from '../assets/night-window.png';

interface Props {
  size?: number;
  kanji?: boolean;
}

const { size = 28, kanji = true } = Astro.props;
---

<span class="brand-lockup" style={`--icon:${size}px`}>
  <Image src={icon} alt="" width={size} height={size} densities={[1, 2, 3]} loading="eager" class="brand-icon" />
  <span class="wordmark">yomado</span>
  {kanji && <span class="kanji" lang="zh-CN">夜窗</span>}
</span>

<style>
  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--icon) * 0.32);
    color: inherit;
    white-space: nowrap;
  }

  .brand-lockup > * {
    flex-shrink: 0;
  }

  .brand-icon {
    width: var(--icon);
    height: var(--icon);
    border-radius: 22%;
  }

  .wordmark {
    font-size: calc(var(--icon) * 0.74);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .kanji {
    color: var(--ink-2);
    font-size: calc(var(--icon) * 0.44);
    font-weight: 500;
    letter-spacing: 0.16em;
    line-height: 1;
  }
</style>
