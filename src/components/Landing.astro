---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import Hero from './Hero.astro';
import Story from './Story.astro';
import Panel from './Panel.astro';
import Finale from './Finale.astro';
import SiteFooter from './SiteFooter.astro';
import { copyFor } from '../i18n';
import { PAGE_VISUAL } from '../lib/captions';
import { posterUrl } from '../lib/media';
import { LOCALE_PATH, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = copyFor(locale);
---

<Base
  locale={locale}
  title={copy.meta.title}
  description={copy.meta.description}
  path={LOCALE_PATH[locale]}
  ogAlt={copy.meta.ogAlt}
  autoLanguage={locale === 'en'}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={posterUrl(PAGE_VISUAL[locale], 'wide')} media="(min-width: 641px)" fetchpriority="high" />
    <link rel="preload" as="image" href={posterUrl(PAGE_VISUAL[locale], 'tall')} media="(max-width: 640px)" fetchpriority="high" />
  </Fragment>
  <a class="skip" href="#main">{copy.skip}</a>
  <SiteHeader locale={locale} copy={copy} />
  <main id="main">
    <Hero locale={locale} copy={copy} />
    <Story copy={copy} />
    <Panel locale={locale} copy={copy} />
    <Finale locale={locale} copy={copy} />
  </main>
  <SiteFooter locale={locale} copy={copy} />
</Base>

<script>
  import '../scripts/page';
  import '../scripts/film';
  import '../scripts/story';
</script>
