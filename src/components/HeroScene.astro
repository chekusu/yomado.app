---
// The hero illustration. The default styles are the final frame (agent window on the lit
// virtual display, your monitor resting); `.play` animates into it once. Reduced motion
// and no-animation browsers simply show the final frame.
import Icon from './Icon.astro';
import { nightWindow } from '../lib/shape';
import type { Copy } from '../i18n';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;

// The virtual display takes the app icon's night-window silhouette.
const VS = nightWindow(360, 48, 320, 200, { tl: 28, br: 10, r: 34 });
const floor = [420, 445, 470, 495, 520, 545, 570].map((x) => [x, 210, x + (495 - x) * 0.567, 176]);
---

<figure class="hero-figure">
  <div class="scene play" id="hero-scene">
    <svg viewBox="24 24 680 452" role="img" aria-labelledby="hero-scene-title hero-scene-desc">
      <title id="hero-scene-title">{copy.hero.figTitle}</title>
      <desc id="hero-scene-desc">{copy.hero.figDesc}</desc>
      <defs>
        <radialGradient id="hs-halo" cx="0.5" cy="0.5" r="0.5">
          <stop offset="0" stop-color="#fcf8e1" stop-opacity="0.42"></stop>
          <stop offset="0.5" stop-color="#fcf8e1" stop-opacity="0.12"></stop>
          <stop offset="1" stop-color="#fcf8e1" stop-opacity="0"></stop>
        </radialGradient>
        <linearGradient id="hs-lit" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#fffdf3"></stop>
          <stop offset="1" stop-color="#f3eacb"></stop>
        </linearGradient>
        <linearGradient id="hs-screen" x1="0" y1="0" x2="0.4" y2="1">
          <stop offset="0" stop-color="#22336f"></stop>
          <stop offset="1" stop-color="#131e4d"></stop>
        </linearGradient>
        <linearGradient id="hs-glass" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.07"></stop>
          <stop offset="0.45" stop-color="#ffffff" stop-opacity="0"></stop>
        </linearGradient>
        <clipPath id="hs-vs-clip"><path d={VS}></path></clipPath>
        <clipPath id="hs-viewport"><rect x="420" y="116" width="150" height="94"></rect></clipPath>
        <filter id="hs-shadow" x="-30%" y="-30%" width="160%" height="170%">
          <feDropShadow dx="0" dy="8" stdDeviation="9" flood-color="#050a1e" flood-opacity="0.38"></feDropShadow>
        </filter>
      </defs>

      <ellipse class="halo" cx="520" cy="160" rx="184" ry="160" fill="url(#hs-halo)"></ellipse>

      <!-- yomado virtual display -->
      <path class="vs-outline" d={VS} fill="none" stroke="#fcf8e1" stroke-opacity="0.6" stroke-width="1.5" stroke-dasharray="3 7" stroke-linecap="round"></path>
      <g class="vs-light">
        <path d={VS} fill="url(#hs-lit)"></path>
        <g clip-path="url(#hs-vs-clip)">
          <rect x="360" y="48" width="320" height="10" fill="#e9dfb4" opacity="0.55"></rect>
        </g>
        <path d={VS} fill="none" stroke="#ffffff" stroke-opacity="0.7"></path>
      </g>

      <!-- your physical display -->
      <g class="monitor">
        <path d="M176 380h28l7 44h-42z" fill="#0d173b" stroke="#22356d"></path>
        <rect x="126" y="423" width="128" height="9" rx="4.5" fill="#101b45" stroke="#22356d"></rect>
        <rect x="40" y="190" width="300" height="190" rx="12" fill="#0b1436" stroke="#283c78"></rect>
        <rect x="50" y="200" width="280" height="166" rx="4" fill="url(#hs-screen)"></rect>
        <rect x="50" y="200" width="280" height="9" fill="#ffffff" opacity="0.06"></rect>
        <g class="own-window">
          <rect x="66" y="222" width="118" height="100" rx="5" fill="#e6e9f3"></rect>
          <path d="M71 222h108a5 5 0 0 1 5 5v9H66v-9a5 5 0 0 1 5-5z" fill="#d3d8e9"></path>
          <circle cx="74" cy="229" r="2.1" fill="#adb4d0"></circle>
          <circle cx="81.5" cy="229" r="2.1" fill="#adb4d0"></circle>
          <circle cx="89" cy="229" r="2.1" fill="#adb4d0"></circle>
          <g fill="#aab1cc">
            <rect x="76" y="246" width="82" height="4" rx="2"></rect>
            <rect x="76" y="256" width="96" height="4" rx="2"></rect>
            <rect x="76" y="266" width="68" height="4" rx="2"></rect>
            <rect x="76" y="281" width="90" height="4" rx="2"></rect>
            <rect x="76" y="291" width="58" height="4" rx="2"></rect>
            <rect x="76" y="301" width="84" height="4" rx="2"></rect>
          </g>
        </g>
        <rect class="phys-dim" x="50" y="200" width="280" height="166" rx="4" fill="#050a1d"></rect>
        <rect x="50" y="200" width="280" height="166" rx="4" fill="url(#hs-glass)"></rect>
        <circle class="led" cx="190" cy="373" r="2.2" fill="#f2c27b"></circle>
      </g>

      <path class="trail" d="M258 272C300 160 390 118 485 155" fill="none" stroke="#fcf8e1" stroke-opacity="0.7" stroke-width="1.5" stroke-dasharray="2 6" stroke-linecap="round"></path>

      <!-- the agent's app window: drawn in its final place on the virtual display -->
      <g class="app" filter="url(#hs-shadow)">
        <rect x="400" y="100" width="170" height="110" rx="7" fill="#161e48" stroke="#2b3b77"></rect>
        <path d="M407 100h156a7 7 0 0 1 7 7v9H400v-9a7 7 0 0 1 7-7z" fill="#212b5d"></path>
        <circle cx="410" cy="108" r="2.6" fill="#ec7b69"></circle>
        <circle cx="419" cy="108" r="2.6" fill="#efc566"></circle>
        <circle cx="428" cy="108" r="2.6" fill="#76c38b"></circle>
        <rect x="400" y="116" width="20" height="94" fill="#121941"></rect>
        <rect x="405" y="124" width="10" height="10" rx="2.5" fill="#f2c27b" opacity="0.75"></rect>
        <rect x="405" y="138" width="10" height="10" rx="2.5" fill="#fcf8e1" opacity="0.18"></rect>
        <rect x="405" y="152" width="10" height="10" rx="2.5" fill="#fcf8e1" opacity="0.18"></rect>
        <g clip-path="url(#hs-viewport)" stroke="#fcf8e1" stroke-opacity="0.16" stroke-width="0.8">
          {floor.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2}></line>)}
          <line x1="452.5" y1="184" x2="537.5" y2="184"></line>
          <line x1="440" y1="194" x2="550" y2="194"></line>
          <line x1="425" y1="206" x2="565" y2="206"></line>
        </g>
        <g fill="none" stroke="#f2b56f" stroke-width="1.4" stroke-linejoin="round">
          <path d="M478 140h26v26h-26z" fill="#f2b56f" fill-opacity="0.12"></path>
          <path d="M478 140l11-9h26l-11 9M504 140l11-9v26l-11 9"></path>
          <path d="M489 131v26h26M489 157l-11 9" stroke-opacity="0.35"></path>
        </g>
        <circle cx="556" cy="128" r="6" fill="none" stroke="#fcf8e1" stroke-opacity="0.3"></circle>
      </g>

      <!-- the agent: a screenshot, then a click -->
      <g class="snap" fill="none" stroke="#fcf8e1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M350 58V38h20M670 38h20v20M690 238v20h-20M370 258h-20v-20"></path>
      </g>
      <circle class="ripple" cx="522" cy="170" r="12" fill="none" stroke="#fcf8e1" stroke-width="1.6"></circle>
      <g class="cursor">
        <path d="M522 170v15.5l4.2-3.7 2.8 6.2 2.6-1.1-2.7-6h5.5z" fill="#fffcef" stroke="#0c1940" stroke-width="1.1" stroke-linejoin="round"></path>
      </g>
    </svg>
    <span class="label label-v" aria-hidden="true"><span>{copy.hero.labelVirtual}</span><span class="res">1920 × 1080</span></span>
    <span class="label label-p" aria-hidden="true">{copy.hero.labelPhysical}</span>
  </div>
  <figcaption>
    <span>{copy.hero.caption}</span>
    <button type="button" class="replay" data-replay="hero-scene">
      <Icon name="replay" size={16} />
      {copy.hero.replay}
    </button>
  </figcaption>
</figure>

<style>
  .hero-figure {
    position: relative;
  }

  .scene {
    position: relative;
    aspect-ratio: 680 / 452;
  }

  .scene svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .halo,
  .snap,
  .ripple {
    transform-box: fill-box;
    transform-origin: center;
  }

  .app {
    transform-box: fill-box;
    transform-origin: 0 0;
  }

  /* Final frame. */
  .vs-outline,
  .trail,
  .snap,
  .ripple {
    opacity: 0;
  }

  .phys-dim {
    opacity: 0.9;
  }

  .label {
    position: absolute;
    color: var(--mist-300);
    font: 400 clamp(0.6875rem, 0.55rem + 0.35vw, 0.8125rem) / 1.3 var(--font-mono);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* Sits on the virtual display's top edge (y = 48, 24 into the viewBox) and wraps upward when narrow. */
  .label-v {
    left: 49.4%;
    width: 47%;
    bottom: calc(94.7% + 8px);
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.7em;
    color: var(--ivory-100);
    white-space: normal;
  }

  .label-v .res {
    color: var(--mist-400);
  }

  .label-p {
    left: 24.4%;
    top: 94%;
    transform: translateX(-50%);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 18px;
    margin-top: 10px;
    color: var(--mist-400);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .replay {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 2px;
    border: 0;
    background: none;
    color: var(--mist-300);
    font: 400 0.8125rem/1 var(--font-mono);
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .replay:hover {
    color: var(--ivory-50);
  }

  /* The sequence: create the screen, move the window, rest the monitor, let the agent work. */
  .play .halo {
    animation: yo-halo-in 1.6s 0.7s var(--ease) both;
  }

  .play .vs-outline {
    animation: yo-outline 0.8s 1.05s ease both;
  }

  .play .vs-light {
    animation: yo-fade-in 1.1s 0.7s ease both;
  }

  .play .label-v {
    animation: yo-rise-in 0.7s 1.2s var(--ease) both;
  }

  .play .app {
    animation: yo-app-move 1.8s 2s cubic-bezier(0.65, 0, 0.25, 1) both;
  }

  .play .trail {
    animation: yo-trail 2s 1.95s ease both;
  }

  .play .phys-dim {
    animation: yo-dim 1.4s 4s ease both;
  }

  .play .led {
    animation: yo-fade-in 0.9s 4.8s ease both;
  }

  .play .snap {
    animation: yo-snap 1.1s 5.5s ease both;
  }

  .play .cursor {
    animation: yo-cursor-in 0.9s 6.2s var(--ease) both;
  }

  .play .ripple {
    animation: yo-ripple 0.8s 7.15s ease-out both;
  }

  @keyframes yo-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes yo-outline {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes yo-halo-in {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes yo-rise-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes yo-app-move {
    0% {
      transform: translate(-204px, 132px) scale(0.729);
    }
    50% {
      transform: translate(-100px, 20px) scale(0.87);
    }
    100% {
      transform: none;
    }
  }

  @keyframes yo-trail {
    0% {
      opacity: 0;
      stroke-dashoffset: 48;
    }
    25% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      stroke-dashoffset: 0;
    }
  }

  @keyframes yo-dim {
    from {
      opacity: 0;
    }
    to {
      opacity: 0.9;
    }
  }

  @keyframes yo-snap {
    0% {
      opacity: 0;
      transform: scale(1.035);
    }
    30%,
    70% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes yo-cursor-in {
    from {
      opacity: 0;
      transform: translate(36px, 30px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes yo-ripple {
    0% {
      opacity: 0.9;
      transform: scale(0.25);
    }
    100% {
      opacity: 0;
      transform: scale(1.5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .play *,
    .play {
      animation: none !important;
    }

    .replay {
      display: none;
    }
  }
</style>
