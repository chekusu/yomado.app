---
// The real app: its control panel (rendered with example data) and what has been tested.
import { Picture } from 'astro:assets';
import panel from '../assets/control-panel.png';
import { phrased } from '../lib/text';
import type { Copy } from '../i18n';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
---

<section class="app wrap" id="app" aria-labelledby="app-title">
  <div class="head">
    <p class="kicker">{copy.app.kicker}</p>
    <h2 id="app-title" class="display" set:html={phrased(copy.app.title)} />
    <p class="prose" set:html={copy.app.textHtml} />
  </div>

  <figure class="panel">
    <div class="frame">
      <Picture
        src={panel}
        formats={['avif', 'webp']}
        widths={[700, 1000, 1400, 2000]}
        sizes="(min-width: 1260px) 1160px, calc(100vw - 2 * var(--gutter) - 24px)"
        alt={copy.app.imageAlt}
        loading="lazy"
        decoding="async"
        quality={88}
      />
    </div>
    <figcaption>{copy.app.caption}</figcaption>
  </figure>

  <div class="notes">
    <div class="log">
      <h3>{copy.app.testedTitle}</h3>
      <ul class="tested">
        {copy.app.tested.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div class="log">
      <h3>{copy.app.pendingTitle}</h3>
      <ul class="pending">
        {copy.app.pending.map((item) => <li>{item}</li>)}
      </ul>
      <p class="source" set:html={copy.app.sourceHtml} />
    </div>
  </div>
</section>

<style>
  .app {
    padding-block: clamp(80px, 11vw, 150px) clamp(56px, 8vw, 110px);
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    column-gap: clamp(28px, 6vw, 96px);
    align-items: end;
  }

  .head .kicker {
    grid-column: 1 / -1;
  }

  .head .prose {
    max-width: 34rem;
  }

  .panel {
    margin-top: clamp(40px, 6vw, 72px);
  }

  .frame {
    padding: clamp(6px, 1vw, 12px);
    border-radius: clamp(16px, 2.2vw, 26px);
    background: linear-gradient(180deg, rgb(252 248 225 / 0.16), rgb(252 248 225 / 0.04));
    box-shadow:
      0 0 0 1px rgb(252 248 225 / 0.12),
      0 30px 120px -30px rgb(252 248 225 / 0.28);
  }

  .frame :global(img) {
    width: 100%;
    border-radius: clamp(10px, 1.6vw, 18px);
  }

  .panel figcaption {
    margin-top: 12px;
    color: var(--mist-400);
    font-size: 0.8125rem;
  }

  .notes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 5vw, 80px);
    margin-top: clamp(48px, 7vw, 88px);
  }

  .log h3 {
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgb(252 248 225 / 0.14);
    color: var(--mist-300);
    font: 400 0.8125rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .log ul {
    display: grid;
    gap: 10px;
    list-style: none;
  }

  .log li {
    position: relative;
    padding-left: 28px;
    color: var(--mist-200);
    font-size: 0.975rem;
  }

  .log li::before {
    position: absolute;
    left: 0;
    top: 0.05em;
    font-family: var(--font-mono);
  }

  .tested li::before {
    content: '✓';
    color: var(--ember);
  }

  .pending li {
    color: var(--mist-300);
  }

  .pending li::before {
    content: '○';
    color: var(--mist-400);
  }

  .source {
    margin-top: 20px;
    color: var(--mist-400);
    font-size: 0.875rem;
  }

  .source :global(a) {
    color: var(--mist-300);
  }

  :lang(zh-CN) .log h3 {
    letter-spacing: 0.12em;
  }

  @media (max-width: 860px) {
    .head,
    .notes {
      grid-template-columns: minmax(0, 1fr);
    }

    .head .prose {
      margin-top: 22px;
    }
  }
</style>
