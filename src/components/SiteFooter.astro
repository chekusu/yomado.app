---
import Brand from './Brand.astro';
import { LOCALE_PATH, LOCALE_TAG, SITE, withBase, type Locale } from '../lib/site';
import type { Copy } from '../i18n';

interface Props {
  locale: Locale;
  copy: Copy;
  /** Site-relative path of the same page in the other language. */
  otherPath?: string;
}

const { locale, copy } = Astro.props;
const other: Locale = locale === 'en' ? 'zh-cn' : 'en';
const otherPath = Astro.props.otherPath ?? LOCALE_PATH[other];
---

<footer class="site-footer night" data-tone="night">
  <div class="wrap">
    <div class="top">
      <div class="sign">
        <Brand size={28} />
        <p class="tagline">{copy.footer.tagline}</p>
      </div>
      <nav aria-label={copy.footer.navLabel}>
        <a href={withBase(`${LOCALE_PATH[locale]}details/`)}>{copy.footer.details}</a>
        <a href={`${SITE.appRepository}/releases`}>{copy.footer.releases}</a>
        <a href={SITE.appRepository}>{copy.footer.source}</a>
        <a href={SITE.siteRepository}>{copy.footer.site}</a>
        <a href={`${SITE.appRepository}/blob/main/LICENSE`}>{copy.footer.license}</a>
        <a href={withBase(otherPath)} hreflang={LOCALE_TAG[other]} lang={LOCALE_TAG[other]} data-lang-switch>{copy.nav.switchLabel}</a>
      </nav>
    </div>
    <p class="fine">{copy.footer.fine}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 36px 44px;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px 40px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--rule);
  }

  .sign {
    display: grid;
    gap: 10px;
  }

  .tagline {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.875rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    max-width: 560px;
  }

  nav a {
    color: var(--ink-2);
    font-size: 0.8125rem;
  }

  nav a:hover {
    color: var(--ink);
  }

  .fine {
    margin-top: 18px;
    max-width: 72ch;
  }
</style>
