---
import Brand from './Brand.astro';
import { LOCALES, LOCALE_NAME, LOCALE_PATH, LOCALE_TAG, SITE, localeHref, withBase, type Locale } from '../lib/site';
import type { Copy } from '../i18n';

interface Props {
  locale: Locale;
  copy: Copy;
  /** This page's path below each locale's root: '' for home, 'details/' or 'watch/'. */
  route?: string;
}

const { locale, copy, route = '' } = Astro.props;
---

<footer class="site-footer night" data-tone="night">
  <div class="wrap">
    <div class="top">
      <div class="sign">
        <Brand size={28} />
        <p class="tagline">{copy.footer.tagline}</p>
      </div>
      <nav aria-label={copy.footer.navLabel}>
        <a href={withBase(`${LOCALE_PATH[locale]}details/`)}>{copy.footer.details}</a>
        <a href={withBase(`${LOCALE_PATH[locale]}watch/`)}>{copy.footer.film}</a>
        <a href={`${SITE.appRepository}/releases`}>{copy.footer.releases}</a>
        <a href={SITE.appRepository}>{copy.footer.source}</a>
        <a href={SITE.siteRepository}>{copy.footer.site}</a>
        <a href={`${SITE.appRepository}/blob/main/LICENSE`}>{copy.footer.license}</a>
      </nav>
    </div>
    <div class="bottom">
      <p class="fine">{copy.footer.fine}</p>
      <nav class="langs" aria-label={copy.nav.language}>
        {
          LOCALES.map((l) => (
            <a
              href={localeHref(l, route)}
              hreflang={LOCALE_TAG[l]}
              lang={LOCALE_TAG[l]}
              aria-current={l === locale ? 'page' : undefined}
              data-lang-switch
              data-locale={l}
            >
              <bdi>{LOCALE_NAME[l].full}</bdi>
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 36px 44px;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px 40px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--rule);
  }

  .sign {
    display: grid;
    gap: 10px;
  }

  .tagline {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.875rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    max-width: 560px;
  }

  nav a {
    color: var(--ink-2);
    font-size: 0.8125rem;
  }

  nav a:hover {
    color: var(--ink);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px 40px;
    margin-top: 18px;
  }

  .fine {
    max-width: 72ch;
  }

  .langs {
    gap: 10px 18px;
  }

  .langs a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }
</style>
