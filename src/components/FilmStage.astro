    width: 60%;
  }

  /* Blender's default dark theme, simplified */
  .blender {
    position: relative;
    background: #303030;
    font-size: 13px;
  }

  .blender > * {
    position: absolute;
  }

  .blender .dk-title {
    position: absolute;
    inset: 0 0 auto;
  }

  .bl-top {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 10px;
    background: #232323;
    color: #dcdcdc;
  }

  .bl-top :global(.bl-logo) {
    width: 16px;
    height: 16px;
  }

  .bl-tabs {
    display: flex;
    gap: 2px;
    margin-left: 18px;
  }

  .bl-tabs b {
    padding: 3px 10px;
    border-radius: 5px 5px 0 0;
    color: #b5b5b5;
    font-weight: 400;
  }

  .bl-tabs b.on {
    background: #303030;
    color: #f2f2f2;
  }

  .bl-scene {
    padding: 2px 12px;
    border-radius: 4px;
    background: #2d2d2d;
    color: #c8c8c8;
  }

  .bl-scene:first-of-type {
    margin-left: auto;
  }

  .bl-view {
    overflow: hidden;
    background: linear-gradient(180deg, #3d3d3d, #333);
  }

  .bl-vhead,
  .bl-ehead {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 14px;
    height: 26px;
    padding: 0 8px;
    background: rgb(48 48 48 / 0.92);
    color: #d7d7d7;
  }

  .bl-drop {
    padding: 1px 22px 1px 8px;
    border-radius: 4px;
    background: #4a4a4a linear-gradient(135deg, transparent 45%, #bdbdbd 45% 55%, transparent 55%) right 8px center / 6px 6px no-repeat;
  }

  .bl-shading {
    display: flex;
    gap: 2px;
    margin-left: auto;
    padding: 2px;
    border-radius: 5px;
    background: #1f1f1f;
  }

  .sh {
    position: relative;
    width: 24px;
    height: 20px;
    border-radius: 4px;
  }

  .sh::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 4px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .sh0::after {
    border: 1.5px solid #cfcfcf;
    background: linear-gradient(90deg, transparent 45%, #cfcfcf 45% 55%, transparent 55%);
  }

  .sh1::after {
    background: radial-gradient(circle at 35% 35%, #ffffff, #9a9a9a);
  }

  .sh2::after {
    background: conic-gradient(#d9d9d9 0 25%, #777 0 50%, #d9d9d9 0 75%, #777 0);
  }

  .sh3::after {
    background: radial-gradient(circle at 35% 30%, #fff6e0, #e0a050 55%, #7a4a20);
  }

  .sh.on {
    background: #4772b3;
  }

  .sh.pressed {
    background: #5a8ad6;
  }

  .bl-view canvas {
    position: absolute;
    left: 0;
    top: 26px;
    width: 1128px;
    height: 656px;
  }

  .bl-tools {
    position: absolute;
    left: 8px;
    top: 40px;
    display: grid;
    gap: 3px;
    padding: 4px;
    border-radius: 6px;
    background: rgb(40 40 40 / 0.9);
  }

  .bl-tools i {
    width: 28px;
    height: 28px;
    border-radius: 4px;
    background:
      linear-gradient(#bdbdbd, #bdbdbd) center / 12px 2px no-repeat,
      linear-gradient(#bdbdbd, #bdbdbd) center / 2px 12px no-repeat,
      #3c3c3c;
  }

  .bl-tools i.on {
    background:
      linear-gradient(#fff, #fff) center / 14px 14px no-repeat,
      #4772b3;
    box-shadow: inset 0 0 0 9px #4772b3;
  }

  .bl-vinfo {
    position: absolute;
    left: 56px;
    top: 38px;
    display: grid;
    gap: 2px;
    color: #e8e8e8;
    font-size: 13px;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.6);
  }

  .bl-gizmo {
    position: absolute;
    width: 100px;
    height: 100px;
    overflow: visible;
  }

  .g-bg {
    fill: rgb(255 255 255 / 0);
  }

  .bl-gizmo.hover .g-bg {
    fill: rgb(255 255 255 / 0.12);
  }

  .bl-gizmo :global(.ax line) {
    stroke-width: 2.5;
  }

  .bl-gizmo :global(.ax text) {
    font-size: 12px;
    font-weight: 700;
    fill: #1b1b1b;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .bl-outliner,
  .bl-props,
  .bl-timeline {
    overflow: hidden;
    background: #282828;
  }

  .bl-rows {
    position: absolute;
    inset: 32px 0 0;
    display: grid;
    align-content: start;
  }

  .bl-rows span {
    height: 24px;
    padding-left: 14px;
    line-height: 24px;
    color: #d4d4d4;
  }

  .bl-rows span:nth-child(even) {
    background: #2b2b2b;
  }

  .bl-rows .r1 {
    padding-left: 34px;
  }

  .bl-rows .r2 {
    padding-left: 58px;
  }

  .bl-rows .sel {
    background: #334d80 !important;
    color: #ffaf29;
  }

  .bl-ptabs {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    display: grid;
    align-content: start;
    gap: 4px;
    width: 40px;
    padding: 8px 6px;
    background: #222;
  }

  .bl-ptabs i {
    height: 28px;
    border-radius: 5px;
    background: #2f2f2f;
  }

  .bl-ptabs i.on {
    background: #545454 linear-gradient(135deg, transparent 40%, #4fb3ff 40% 60%, transparent 60%) center / 14px 14px no-repeat;
  }

  .bl-pobj {
    position: absolute;
    left: 52px;
    top: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #e0e0e0;
  }

  .bl-pobj i {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background: #ff8f2a;
  }

  .bl-add {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 12px;
    border-radius: 5px;
    background: #545454;
    color: #eeeeee;
  }

  .bl-add.press {
    background: #4772b3;
  }

  .wrench {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    background: #8aa6d6;
    transform: rotate(45deg) scaleX(0.4);
  }

  .caret {
    margin-left: auto;
    width: 0;
    height: 0;
    border: 5px solid transparent;
    border-top-color: #cfcfcf;
    translate: 0 3px;
  }

  .bl-mod {
    display: grid;
    gap: 6px;
    padding: 0 0 10px;
    border-radius: 6px;
    background: #3d3d3d;
    color: #dcdcdc;
    opacity: 0;
  }

  .bl-modhead {
    display: flex;
    align-items: center;
    gap: 9px;
    height: 26px;
    padding: 0 10px;
    border-radius: 6px 6px 0 0;
    background: #474747;
  }

  .tri {
    width: 0;
    height: 0;
    border: 5px solid transparent;
    border-top-color: #cfcfcf;
    translate: 0 3px;
  }

  .tri.closed {
    border-top-color: transparent;
    border-left-color: #cfcfcf;
    translate: 3px 0;
  }

  .bl-modicons {
    display: flex;
    gap: 6px;
    margin-left: auto;
  }

  .bl-modicons i {
    width: 18px;
    height: 16px;
    border-radius: 3px;
    background: #5a5a5a;
  }

  .bl-modicons em {
    color: #bdbdbd;
    font-style: normal;
  }

  .bl-seg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    margin: 0 10px;
  }

  .bl-seg b {
    height: 22px;
    border-radius: 4px;
    background: #545454;
    font-weight: 400;
    text-align: center;
    line-height: 22px;
  }

  .bl-seg b.on {
    background: #4772b3;
  }

  .bl-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    align-items: center;
    gap: 10px;
    height: 22px;
    padding: 0 10px;
  }

  .bl-row > span:first-child {
    text-align: right;
    color: #c4c4c4;
  }

  .bl-field {
    height: 22px;
    border-radius: 4px;
    background: #545454;
    text-align: center;
    line-height: 22px;
    font-variant-numeric: tabular-nums;
  }

  .bl-field.edit {
    background: #1d1d1d;
    box-shadow: inset 0 0 0 1px #4772b3;
    text-align: left;
    padding-left: 10px;
  }

  .bl-field.edit::after {
    content: '';
    display: inline-block;
    width: 1.5px;
    height: 14px;
    margin-left: 1px;
    vertical-align: -2px;
    background: #fff;
  }

  .bl-field.hover {
    background: #656565;
  }

  .bl-row.check,
  .bl-row.sub {
    display: flex;
    gap: 8px;
    padding-left: 160px;
  }

  .bl-row.check i {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background: #4772b3 linear-gradient(135deg, transparent 50%, #fff 50% 62%, transparent 62%) center / 8px 8px no-repeat;
  }

  .bl-menu {
    z-index: 4;
    display: grid;
    padding: 4px 0;
    border-radius: 6px;
    background: rgb(24 24 24 / 0.97);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.5);
    color: #e5e5e5;
    opacity: 0;
  }

  .bl-mi {
    display: flex;
    align-items: center;
    padding: 0 12px;
  }

  .bl-mi em {
    margin-left: auto;
    color: #9a9a9a;
    font-style: normal;
  }

  .bl-mi.on {
    background: #4772b3;
    color: #fff;
  }

  .bl-ruler {
    position: absolute;
    inset: 26px 0 0;
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.05) 0 1px, transparent 1px 43.2px) 18px 0,
      #2a2a2a;
  }

  .bl-ruler span {
    position: absolute;
    top: 4px;
    color: #9b9b9b;
    font-size: 12px;
    translate: -50% 0;
  }

  .bl-playhead {
    position: absolute;
    left: 22px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #4772b3;
  }

  .bl-playhead b {
    position: absolute;
    top: 2px;
    left: -12px;
    width: 26px;
    height: 18px;
    border-radius: 4px;
    background: #4772b3;
    color: #fff;
    font-size: 12px;
    font-weight: 500;
    line-height: 18px;
    text-align: center;
  }

  .bl-transport {
    display: flex;
    gap: 6px;
    margin-left: 40px;
  }

  .bl-transport i {
    width: 18px;
    height: 16px;
    border-radius: 3px;
    background: #4a4a4a;
  }

  .bl-transport i.play {
    background: #4a4a4a linear-gradient(90deg, #cfcfcf, #cfcfcf) center / 6px 8px no-repeat;
  }

  .bl-frames {
    margin-left: auto;
    color: #bdbdbd;
  }

  .bl-status {
    display: flex;
    gap: 26px;
    align-items: center;
    padding: 0 14px;
    background: #232323;
    color: #9d9d9d;
    font-size: 12px;
  }

  /* ---------- Dock ---------- */
  .dock {
    z-index: 30;
    display: flex;
    gap: 12px;
    padding: 10px 14px 12px;
    border-radius: 26px;
    background: rgb(255 255 255 / 0.5);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.7),
      0 14px 36px -14px rgb(20 30 60 / 0.3);
    transform: translateX(-50%);
  }

  .dk-tile {
    position: relative;
    width: 64px;
    height: 64px;
  }

  .dk-tile :global(img) {
    width: 100%;
    height: 100%;
  }

  .dk-tile::after {
    content: '';
    position: absolute;
    bottom: -9px;
    left: 50%;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: rgb(29 29 31 / 0.55);
  }

  /* ---------- The panel window and its menus ---------- */
  .panel-win {
    z-index: 35;
    transform-origin: 1400px -260px;
  }

  .smenu {
    z-index: 40;
  }

  .pm,
  .smenu {
    position: absolute;
    padding: 5px 0;
    border-radius: 8px;
    background: rgb(246 246 246 / 0.98);
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 0.25),
      0 12px 32px rgb(0 0 0 / 0.22);
    color: #1d1d1f;
    font-size: 13px;
    opacity: 0;
    visibility: hidden;
  }

  .pm {
    display: grid;
    min-width: 150px;
  }

  .pm-i,
  .sm-i {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 22px;
    margin: 0 5px;
    padding: 0 10px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .pm-i em,
  .sm-i em {
    margin-left: auto;
    padding-left: 16px;
    color: rgb(0 0 0 / 0.45);
    font-style: normal;
  }

  .pm-i.on,
  .sm-i.on {
    background: #0a7aff;
    color: #fff;
  }

  .pm-i.on em,
  .sm-i.on em {
    color: rgb(255 255 255 / 0.85);
  }

  .pm-sep,
  .sm-sep {
    display: block;
    height: 1px;
    margin: 5px 14px;
    background: rgb(0 0 0 / 0.1);
  }

  .smenu {
    padding: 0;
  }

  .sm-i {
    position: absolute;
    left: 0;
    right: 0;
  }

  .sm-i.off {
    color: rgb(0 0 0 / 0.35);
  }

  .sm-sep {
    position: absolute;
    left: 0;
    right: 0;
    margin-top: 5px;
  }

  .sm-icon {
    width: 16px;
    height: 16px;
  }

  .alert {
    position: absolute;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 8px;
    padding: 20px 16px 16px;
    border-radius: 12px;
    background: rgb(240 240 240 / 0.99);
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 0.25),
      0 24px 60px rgb(0 0 0 / 0.3);
    text-align: center;
    opacity: 0;
    visibility: hidden;
  }

  .alert :global(.alert-icon) {
    width: 64px;
    height: 64px;
    margin-bottom: 4px;
  }

  .alert b {
    font-size: 13px;
    font-weight: 650;
  }

  .alert p {
    margin: 0;
    color: rgb(0 0 0 / 0.75);
    font-size: 11px;
    line-height: 1.45;
  }

  .alert-field {
    display: flex;
    align-items: center;
    justify-self: stretch;
    height: 24px;
    margin-top: 6px;
    padding: 0 7px;
    border-radius: 5px;
    background: #fff;
    box-shadow:
      0 0 0 3px rgb(10 122 255 / 0.35),
      inset 0 0 0 0.5px rgb(0 0 0 / 0.25);
    font-size: 13px;
    text-align: left;
  }

  .alert-field .selected {
    background: #b3d7ff;
  }

  .alert-field i {
    width: 1.5px;
    height: 15px;
    margin-left: 1px;
    background: #1d1d1f;
    opacity: 0;
  }

  .alert-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    justify-self: stretch;
    margin-top: 10px;
  }

  .ab {
    height: 26px;
    border-radius: 6px;
    background: #fff;
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 0.18),
      0 1px 1px rgb(0 0 0 / 0.08);
    font-size: 13px;
    line-height: 26px;
  }

  .ab.default {
    background: #0a7aff;
    color: #fff;
  }

  .ab.default.pressed {
    background: #0063d1;
  }

  .cursor {
    width: 22px;
    height: 30px;
    overflow: visible;
  }

  .cursor path {
    fill: #111;
    stroke: #fff;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .panel-cursor {
    position: absolute;
    z-index: 10;
    opacity: 0;
  }

  /* ---------- The pointer ---------- */
  .pointer {
    z-index: 50;
    width: 0;
    height: 0;
  }

  .pointer .cursor {
    position: absolute;
    left: -2px;
    top: -2px;
  }

  .ripple {
    position: absolute;
    left: -22px;
    top: -22px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid rgb(10 122 255 / 0.8);
    opacity: 0;
  }

  .agent-tag {
    position: absolute;
    left: 20px;
    top: 26px;
    padding: 3px 10px;
    border-radius: 999px;
    background: #16265e;
    color: var(--ivory);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
  }

  /* ---------- The panel callout ---------- */
  .callout {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    opacity: 0;
    visibility: hidden;
  }

  /* ---------- Frame overlays ---------- */
  .capture {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    visibility: hidden;
  }

  .c-dim {
    position: absolute;
    inset: 0;
    background: rgb(255 255 255 / 0.06);
  }

  .c-sweep {
    position: absolute;
    left: 0;
    right: 0;
    height: 120px;
    background: linear-gradient(180deg, rgb(252 248 225 / 0), rgb(252 248 225 / 0.3) 70%, rgb(252 248 225 / 0.9) 98%, rgb(252 248 225 / 0));
  }

  .br {
    position: absolute;
    width: 46px;
    height: 46px;
    border: 0 solid #fff;
    filter: drop-shadow(0 0 6px rgb(10 30 80 / 0.5));
  }

  .br.tl {
    left: 0;
    top: 0;
    border-width: 5px 0 0 5px;
    border-top-left-radius: 10px;
  }

  .br.tr {
    right: 0;
    top: 0;
    border-width: 5px 5px 0 0;
    border-top-right-radius: 10px;
  }

  .br.bl {
    left: 0;
    bottom: 0;
    border-width: 0 0 5px 5px;
    border-bottom-left-radius: 10px;
  }

  .br.brr {
    right: 0;
    bottom: 0;
    border-width: 0 5px 5px 0;
    border-bottom-right-radius: 10px;
  }

  .thumb {
    position: absolute;
    left: 0;
    top: 0;
    width: 240px;
    height: 135px;
    overflow: hidden;
    border-radius: 10px;
    box-shadow:
      0 0 0 3px #fff,
      0 18px 40px rgb(0 0 0 / 0.35);
    opacity: 0;
    visibility: hidden;
  }

  .thumb canvas {
    width: 100%;
    height: 100%;
  }

  /* Keys Codex types: bottom right, clear of the supers' band on the left. */
  .keys {
    position: absolute;
    right: 140px;
    bottom: 110px;
    display: flex;
    gap: 16px;
  }

  .film[data-layout='tall'] .keys {
    right: auto;
    left: 50%;
    bottom: 120px;
    transform: translateX(-50%);
  }

  .keys kbd {
    display: grid;
    place-items: center;
    min-width: 76px;
    height: 76px;
    padding: 0 18px;
    border-radius: 14px;
    background: linear-gradient(#ffffff, #eceef2);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.12),
      0 6px 0 #c9ccd3,
      0 14px 30px rgb(0 0 0 / 0.3);
    color: #1d1d1f;
    font: 600 36px/1 'Inter Variable', sans-serif;
    opacity: 0;
  }

  .keys kbd.pressed {
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.12),
      0 2px 0 #c9ccd3,
      0 8px 18px rgb(0 0 0 / 0.3);
    translate: 0 4px;
  }

  /* Caption bands: a soft light (or, over Blender, dark) gradient behind each super, so it reads
     on whatever the camera shows. Wide: at the bottom, or at the top over the panel callout.
     Tall: the top of the frame, which the camera keeps for them. */
  .band {
    --band: 250 250 252;
    position: absolute;
    left: 0;
    right: 0;
    opacity: 0;
  }

  .band.dark {
    --band: 6 10 28;
  }

  .band.bottom {
    bottom: 0;
    height: 330px;
    background: linear-gradient(to top, rgb(var(--band) / 0.94) 0%, rgb(var(--band) / 0.86) 42%, rgb(var(--band) / 0) 100%);
  }

  .band.top {
    top: 0;
    height: 300px;
    background: linear-gradient(to bottom, rgb(var(--band) / 0.94) 0%, rgb(var(--band) / 0.86) 45%, rgb(var(--band) / 0) 100%);
  }

  /* The portrait frame keeps its top for captions: solid behind the text, fading below it. */
  .film[data-layout='tall'] .band.top {
    height: 430px;
    background: linear-gradient(to bottom, rgb(var(--band) / 0.96) 0%, rgb(var(--band) / 0.96) 68%, rgb(var(--band) / 0) 100%);
  }

  .supers {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .super {
    position: absolute;
    left: 96px;
    bottom: 92px;
    max-width: 1100px;
    margin: 0;
    color: #1d1d1f;
    font-size: 54px;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.12;
    text-wrap: balance;
    opacity: 0;
  }

  /* Chinese and Japanese break only between the phrases the copy marks (| → <wbr>). */
  .film:lang(zh-CN) .super,
  .film:lang(ja) .super {
    letter-spacing: 0.01em;
    line-height: 1.3;
  }

