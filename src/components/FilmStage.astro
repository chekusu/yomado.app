---
/**
 * Everything the one-minute film shows, drawn once; src/scripts/film-view.ts poses it for any
 * moment of the timeline in src/lib/film.ts and src/scripts/film-garment.ts renders the 3D views.
 *
 * Three layers: the world (displays, screens, windows, the panel window and the menu bar menu) in
 * display points under a camera transform; the panel callout, a closer view of the same panel; and
 * the frame (sky, label, supers, keys, captures, the end card) in frame pixels. Apps appear with
 * their own icons; their windows are simplified recreations. Codex and GrokBot are only names.
 */
import AppIcon from './AppIcon.astro';
import ControlPanel from './ControlPanel.astro';
import { iconLargest, type AppId } from '../lib/apps';
import { MENUBAR_ICON } from '../lib/menubar';
import { exampleCards } from '../lib/panel';
import { RELEASE } from '../lib/site';
import { phrased } from '../lib/text';
import type { FilmScript } from '../i18n';
import {
  BLENDER,
  FILM_SIZE,
  GENERATE_MENU,
  GROK_ROWS,
  MARK_ICON,
  MENU,
  MODIFIER_MENU,
  PANEL_WIN,
  SCREENS_BY_LAYOUT,
  STATUS_MENU,
  WINDOWS,
  alertBox,
  grokSubmenuAt,
  menuHeight,
  rowTop,
  statusRows,
  type FilmLayout,
  type MenuRow,
} from '../lib/film';

interface Props {
  layout: FilmLayout;
  script: FilmScript;
  lang: string;
}

const { layout, script, lang } = Astro.props;
const size = FILM_SIZE[layout];
const SCREENS = SCREENS_BY_LAYOUT[layout];

const box = (b: { x: number; y: number; w: number; h: number }) => `left:${b.x}px;top:${b.y}px;width:${b.w}px;height:${b.h}px`;
const winBox = (id: keyof typeof WINDOWS) => `width:${WINDOWS[id].w}px;height:${WINDOWS[id].h}px`;

// Every panel card, GrokBot's included; the film shows and hides them as screens come and go.
const cards = [
  ...exampleCards({ one: [], two: [], codex: [] }),
  { id: 'grok', name: '虚拟屏 2 · GrokBot', detail: '1920 × 1080', logical: { w: 1920, h: 1080 }, virtual: true, apps: [] as AppId[] },
];
const panelApps: AppId[] = ['blender', 'md', 'wechat', 'chrome'];
const dock: AppId[] = ['wechat', 'chrome', 'blender', 'md', 'yomado'];
const alert = alertBox();

// The window path of the night-window mark, without its crescent (as in Scene.astro).
const { x: mx, y: my, w: mw, h: mh, tl, br } = MARK_ICON;
const markPath =
  `M${mx} ${my + tl}A${tl} ${tl} 0 0 1 ${mx + tl} ${my}H${mx + mw - br}A${br} ${br} 0 0 1 ${mx + mw} ${my + br}` +
  `V${my + mh - br}A${br} ${br} 0 0 1 ${mx + mw - br} ${my + mh}H${mx + br}A${br} ${br} 0 0 1 ${mx} ${my + mh - br}Z`;

const menuRows = (rows: MenuRow[]) => rows;
const first = statusRows('first');
const second = statusRows('second');
const sub = grokSubmenuAt();
const timelineTicks = Array.from({ length: 11 }, (_, i) => i * 25);
---

<div class="film" data-film-stage data-layout={layout} lang={lang} style={`width:${size.w}px;height:${size.h}px`}>
  <!-- Sky: daylight studio to night -->
  <div class="sky"><i class="sky-day"></i><i class="sky-dusk" data-sky-dusk></i><i class="sky-night" data-sky-night></i></div>

  <!-- ===================== The world, in display points ===================== -->
  <div class="world" data-world>
    {
      (['one', 'two'] as const).map((id) => {
        const s = SCREENS[id];
        return (
          <div class="display fade" data-display={id} style={`left:${s.x}px;top:${s.y}px`}>
            <div class="d-stand">
              <i class="d-neck" />
              <i class="d-foot" />
              <i class="d-shadow" />
            </div>
            <div class="d-bezel" />
            <div class:list={['d-screen', id]}>
              <div class="wallpaper" />
              <div class:list={['menubar', { main: id === 'one' }]}>
                <i class="mb-dot" />
                <b class="mb-app" data-active-app={id === 'one' ? '' : undefined}>
                  {id === 'one' ? 'Blender' : 'Google Chrome'}
                </b>
                <i class="mb-item w1" />
                <i class="mb-item w2" />
                <i class="mb-item w3" />
                <i class="mb-item w4" />
                <span class="mb-right">
                  {id === 'one' && (
                    <span class="mb-status" data-status-icon>
                      <svg viewBox={MENUBAR_ICON.viewBox}>
                        <path d={MENUBAR_ICON.path} />
                      </svg>
                    </span>
                  )}
                  <i class="mb-glyph" />
                  <i class="mb-glyph" />
                  <span class="mb-clock">9:41</span>
                </span>
              </div>
            </div>
          </div>
        );
      })
    }

    {
      (['codex', 'grok'] as const).map((id) => {
        const s = SCREENS[id];
        return (
          <>
            <div class="vlabel" data-vlabel={id} style={`left:${s.x}px;top:${s.y - 120}px;width:${s.w}px`}>
              <span class="vl-name">{s.name}</span>
              <span class="vl-meta">{s.logical}</span>
              <span class="vl-chips">
                {(['blender', 'md', 'chrome'] as const).map((app) => (
                  <span class="vl-chip" data-vchip={`${id}-${app}`}>
                    <AppIcon app={app} size={84} largest loading="eager" />
                  </span>
                ))}
              </span>
            </div>
            <div class="vscreen" data-vscreen={id} style={box(s)}>
              <i class="vs-wall" />
              <div class="menubar dark">
                <i class="mb-dot" />
                <b class="mb-app">{id === 'codex' ? 'Blender' : 'Google Chrome'}</b>
                <i class="mb-item w1" />
                <i class="mb-item w2" />
                <i class="mb-item w3" />
                <span class="mb-right">
                  <span class="mb-status">
                    <svg viewBox={MENUBAR_ICON.viewBox}>
                      <path d={MENUBAR_ICON.path} />
                    </svg>
                  </span>
                  <i class="mb-glyph" />
                  <span class="mb-clock">9:41</span>
                </span>
              </div>
              <i class="vs-sweep" />
            </div>
          </>
        );
      })
    }

    <!-- Your windows -->
    <div class="fw light notes fade" data-win="notes" style={winBox('notes')}>
      <div class="fw-tb"><i></i><i></i><i></i></div>
      <div class="notes-body">
        <div class="notes-list"><i class="on"></i><i></i><i></i><i></i><i></i></div>
        <div class="notes-page"><b></b><i></i><i></i><i class="short"></i><i></i><i></i><i class="short"></i></div>
      </div>
    </div>
    <div class="fw light mail fade" data-win="mail" style={winBox('mail')}>
      <div class="fw-tb"><i></i><i></i><i></i></div>
      <div class="mail-body">
        <div class="mail-side"><i></i><i></i><i></i><i></i></div>
        <div class="mail-list">
          {[0, 1, 2, 3, 4].map((n) => <div class:list={['row', { on: n === 0 }]}><b></b><i></i><i class="short"></i></div>)}
        </div>
        <div class="mail-read"><b></b><i></i><i></i><i class="short"></i><i></i><i class="short"></i></div>
      </div>
    </div>
    <div class="fw light photos fade" data-win="photos" style={winBox('photos')}>
      <div class="fw-tb"><i></i><i></i><i></i></div>
      <div class="photos-grid">
        {Array.from({ length: 12 }, (_, i) => <i class={`ph ph${i % 6}`} />)}
      </div>
    </div>

    <!-- Google Chrome -->
    <div class="fw chrome fade" data-win="chrome" style={winBox('chrome')}>
      <div class="cr-tabs">
        <span class="cr-lights"><i></i><i></i><i></i></span>
        <span class="cr-tab"><u></u><b>Swatches</b><em>×</em></span>
        <span class="cr-new">+</span>
      </div>
      <div class="cr-bar">
        <span class="cr-nav">‹ › ↻</span>
        <span class="cr-omni"><i></i><b></b></span>
      </div>
      <div class="cr-page">
        <div class="cr-head"><b></b><i></i></div>
        <div class="cr-grid">
          {Array.from({ length: 8 }, (_, i) => <i class={`sw sw${i}`} />)}
        </div>
      </div>
    </div>

    <!-- Marvelous Designer -->
    <div class="fw dark md fade" data-win="md" style={winBox('md')}>
      <div class="dk-title"><span class="dk-lights"><i></i><i></i><i></i></span><span>dress.zprj — Marvelous Designer</span></div>
      <div class="md-menu">
        {['File', 'Edit', '2D Pattern', '3D Garment', 'Avatar', 'Display', 'Preferences', 'Settings', 'Help'].map((m) => <span>{m}</span>)}
      </div>
      <div class="md-tools">
        <span class="md-group">{Array.from({ length: 9 }, () => <i />)}</span>
        <span class="md-group">{Array.from({ length: 8 }, () => <i />)}</span>
      </div>
      <div class="md-panes">
        <div class="md-3d">
          <span class="pane-title">3D Garment</span>
          <canvas data-garment="md" width="560" height="660"></canvas>
          <span class="md-sim"><i></i>Simulation</span>
        </div>
        <div class="md-2d">
          <span class="pane-title">2D Pattern</span>
          <svg viewBox="0 0 440 640">
            <g class="pieces">
              <path class="piece" d="M40 70h120l14 120-26 16h-96l-26-16z"></path>
              <path class="piece on" d="M220 70h120l14 120-26 16h-96l-26-16z"></path>
              <path class="piece" d="M56 250h124l50 330h-224z"></path>
              <path class="piece" d="M238 250h124l50 330h-224z"></path>
              <path class="seam" d="M160 74l14 112M340 74l14 112M180 254l50 322M362 254l50 322"></path>
              <path class="grain" d="M100 110v60M280 110v60M118 320v200M300 320v200"></path>
            </g>
          </svg>
        </div>
        <div class="md-side">
          <span class="side-tab on">Object Browser</span>
          <div class="side-list"><b>Fabric</b><i class="on">Silk Charmeuse</i><i>Cotton Poplin</i><b>Pattern</b><i>Bodice Front</i><i>Bodice Back</i><i>Skirt Front</i><i>Skirt Back</i></div>
          <span class="side-tab">Property Editor</span>
          <div class="side-props"><i></i><i></i><i class="short"></i><i></i><i class="short"></i></div>
        </div>
      </div>
    </div>

    <!-- Blender -->
    <div class="fw dark blender fade" data-win="blender" style={winBox('blender')}>
      <div class="dk-title"><span class="dk-lights"><i></i><i></i><i></i></span><span>dress.blend — Blender</span></div>
      <div class="bl-top" style={box({ x: 0, y: BLENDER.topbar.y, w: WINDOWS.blender.w, h: BLENDER.topbar.h })}>
        <AppIcon app="blender" size={16} largest loading="eager" class="bl-logo" />
        {['File', 'Edit', 'Render', 'Window', 'Help'].map((m) => <span class="bl-menu-item">{m}</span>)}
        <span class="bl-tabs">
          {['Layout', 'Modeling', 'Sculpting', 'UV Editing', 'Texture Paint', 'Shading', 'Animation', 'Rendering', 'Compositing'].map((tab, i) => (
            <b class:list={{ on: i === 0 }}>{tab}</b>
          ))}
        </span>
        <span class="bl-scene">Scene</span>
        <span class="bl-scene">ViewLayer</span>
      </div>

      <div class="bl-view" style={box(BLENDER.view)}>
        <div class="bl-vhead">
          <span class="bl-drop">Object Mode</span>
          <span class="bl-menu-item">View</span>
          <span class="bl-menu-item">Select</span>
          <span class="bl-menu-item">Add</span>
          <span class="bl-menu-item">Object</span>
          <span class="bl-shading">
            {[0, 1, 2, 3].map((i) => (
              <i class={`sh sh${i}`} data-shading={i} />
            ))}
          </span>
        </div>
        <canvas data-garment="blender" width="1128" height="656"></canvas>
        <div class="bl-tools">{Array.from({ length: 9 }, (_, i) => <i class:list={{ on: i === 0 }} />)}</div>
        <div class="bl-vinfo"><span>User Perspective</span><span>(1) Collection | Dress</span></div>
        <svg class="bl-gizmo" data-gizmo viewBox="-50 -50 100 100" style={`left:${BLENDER.gizmo.x - 50}px;top:${BLENDER.gizmo.y - BLENDER.view.y - 50}px`}>
          <circle class="g-bg" r="46"></circle>
          <g data-axes></g>
        </svg>
      </div>

      <div class="bl-outliner" style={box({ x: BLENDER.side.x, y: BLENDER.outliner.y, w: BLENDER.side.w, h: BLENDER.outliner.h })}>
        <div class="bl-ehead"><span class="bl-drop">Outliner</span></div>
        <div class="bl-rows">
          <span class="r0">Scene Collection</span>
          <span class="r1">Collection</span>
          <span class="r2">Camera</span>
          <span class="r2 sel" data-outliner-dress>Dress</span>
          <span class="r2">Dress Form</span>
          <span class="r2">Light</span>
        </div>
      </div>

      <div class="bl-props" style={box({ x: BLENDER.side.x, y: BLENDER.props.y, w: BLENDER.side.w, h: BLENDER.props.h })}>
        <div class="bl-ptabs">{Array.from({ length: 11 }, (_, i) => <i class:list={[`pt${i}`, { on: i === 6 }]} />)}</div>
        <div class="bl-pobj"><i></i>Dress</div>
      </div>
      <div class="bl-add" style={box(BLENDER.addModifier)}><i class="wrench"></i>Add Modifier<i class="caret"></i></div>
      <div class="bl-mod" data-bl-modifier style={`left:${BLENDER.addModifier.x}px;top:${BLENDER.addModifier.y + 36}px;width:${BLENDER.addModifier.w}px`}>
        <div class="bl-modhead"><i class="tri"></i><i class="wrench"></i><b>Subdivision</b><span class="bl-modicons"><i></i><i></i><em>×</em></span></div>
        <div class="bl-seg"><b class="on">Catmull-Clark</b><b>Simple</b></div>
        <div class="bl-row"><span>Levels Viewport</span><span class="bl-field" data-bl-levels>1</span></div>
        <div class="bl-row"><span>Render</span><span class="bl-field">2</span></div>
        <div class="bl-row check"><i></i>Optimal Display</div>
        <div class="bl-row sub"><i class="tri closed"></i>Advanced</div>
      </div>

      <div class="bl-menu" data-bl-menu style={`left:${BLENDER.modifierMenu.x}px;top:${BLENDER.modifierMenu.y - 4}px;width:${BLENDER.modifierMenu.w}px`}>
        {MODIFIER_MENU.map((item, i) => (
          <span class="bl-mi" data-bl-mi={i} style={`height:${BLENDER.modifierMenu.item}px`}>
            {item}
            <em>▸</em>
          </span>
        ))}
      </div>
      <div
        class="bl-menu gen"
        data-bl-generate
        style={`left:${BLENDER.modifierMenu.x - BLENDER.generateMenu.w - 2}px;top:${BLENDER.modifierMenu.y + BLENDER.modifierMenu.item - 4}px;width:${BLENDER.generateMenu.w}px`}
      >
        {GENERATE_MENU.map((item, i) => (
          <span class="bl-mi" data-bl-gi={i} style={`height:${BLENDER.generateMenu.item}px`}>
            {item}
          </span>
        ))}
      </div>

      <div class="bl-timeline" style={box({ x: 0, y: BLENDER.timeline.y, w: BLENDER.view.w, h: BLENDER.timeline.h })}>
        <div class="bl-ehead"><span class="bl-drop">Playback</span><span class="bl-drop">Keying</span><span class="bl-menu-item">View</span><span class="bl-menu-item">Marker</span><span class="bl-transport"><i></i><i></i><i class="play"></i><i></i><i></i></span><span class="bl-frames">Start 1 &nbsp; End 250</span></div>
        <div class="bl-ruler">
          {timelineTicks.map((f) => (
            <span style={`left:${18 + (f / 250) * 1080}px`}>{f}</span>
          ))}
          <i class="bl-playhead"><b>1</b></i>
        </div>
      </div>
      <div class="bl-status" style={box({ x: 0, y: BLENDER.status.y, w: WINDOWS.blender.w, h: BLENDER.status.h })}>
        <span>Select</span><span>Rotate View</span><span>Object</span>
      </div>
    </div>

    <!-- Night light filling Codex at the end -->
    <i class="codex-lit" data-codex-lit style={box(SCREENS.codex)}></i>

    <!-- Your Dock, on Studio Display 1 -->
    <div class="dock fade" style={`left:${SCREENS.one.x + SCREENS.one.w / 2}px;top:${SCREENS.one.y + SCREENS.one.h - 96}px`}>
      {
        dock.map((app) => (
          <span class="dk-tile">
            <AppIcon app={app} size={64} largest loading="eager" />
          </span>
        ))
      }
    </div>

    <!-- A light wash behind the panel while the camera is close on it -->
    <i class="focus" data-focus></i>

    <!-- The control panel window on Studio Display 1 -->
    <div class="panel-win fade" data-panel-win style={`left:${PANEL_WIN.x}px;top:${PANEL_WIN.y}px`}>
      <ControlPanel cards={cards} mode="film" apps={panelApps} version={RELEASE.version}>
        <Fragment slot="overlay">
          <div class="pm" data-pm="add">
            <span class="pm-i">新增虚拟屏</span>
          </div>
          <div class="pm" data-pm="manage">
            <span class="pm-i">重命名…</span>
            <span class="pm-i">分辨率<em>›</em></span>
            <span class="pm-i">HiDPI 更清晰</span>
            <i class="pm-sep"></i>
            <span class="pm-i">关闭这块虚拟屏</span>
          </div>
          <div class="alert" data-alert style={box(alert)}>
            <AppIcon app="yomado" size={64} largest loading="eager" class="alert-icon" />
            <b>给虚拟屏命名</b>
            <p>例如 Codex 或 GrokBot。名称会显示在屏幕和菜单栏中。</p>
            <span class="alert-field"><span data-alert-text>Agent 1</span><i data-alert-caret></i></span>
            <span class="alert-buttons"><span class="ab">取消</span><span class="ab default" data-alert-save>保存</span></span>
          </div>
          <svg class="cursor panel-cursor" data-panel-pointer viewBox="0 0 22 30"><path d="M2 2v22l5.6-5.3 3.6 8.4 3.6-1.5-3.6-8.3h7.6z"></path></svg>
        </Fragment>
      </ControlPanel>
    </div>

    <!-- yomado's menu bar menu, both times it is opened -->
    {
      (
        [
          ['first', first],
          ['second', second],
        ] as const
      ).map(([phase, rows]) => (
        <div class="smenu" data-status-menu={phase} style={`left:${STATUS_MENU.x}px;top:${STATUS_MENU.y}px;width:${MENU.w}px;height:${menuHeight(menuRows(rows))}px`}>
          {rows.map((row, i) =>
            row.kind === 'sep' ? (
              <i class="sm-sep" style={`top:${rowTop(rows, i)}px`} />
            ) : (
              <span class:list={['sm-i', { off: row.disabled }]} data-row={i} style={`top:${rowTop(rows, i)}px`}>
                {row.label}
                {row.sub && <em>›</em>}
              </span>
            ),
          )}
        </div>
      ))
    }
    <div class="smenu" data-status-sub style={`left:${sub.x}px;top:${sub.y}px;width:${MENU.subW}px;height:${menuHeight(GROK_ROWS)}px`}>
      {
        GROK_ROWS.map((row, i) =>
          row.kind === 'sep' ? (
            <i class="sm-sep" style={`top:${rowTop(GROK_ROWS, i)}px`} />
          ) : (
            <span class="sm-i" data-row={i} style={`top:${rowTop(GROK_ROWS, i)}px`}>
              {row.icon && <img class="sm-icon" src={iconLargest(row.icon)} alt="" width="16" height="16" />}
              {row.label}
            </span>
          ),
        )
      }
    </div>

    <!-- The one pointer: yours, or Codex's while it works -->
    <div class="pointer" data-pointer>
      <svg class="cursor" viewBox="0 0 22 30"><path d="M2 2v22l5.6-5.3 3.6 8.4 3.6-1.5-3.6-8.3h7.6z"></path></svg>
      <i class="ripple"></i>
      <span class="agent-tag">Codex</span>
    </div>
  </div>

  <!-- ===================== The panel callout ===================== -->
  <div class="callout" data-callout>
    <ControlPanel cards={cards} mode="film" apps={panelApps} version={RELEASE.version}>
      <Fragment slot="overlay">
        <div class="pm" data-pm="add">
          <span class="pm-i">新增虚拟屏</span>
        </div>
        <div class="pm" data-pm="manage">
          <span class="pm-i">重命名…</span>
          <span class="pm-i">分辨率<em>›</em></span>
          <span class="pm-i">HiDPI 更清晰</span>
          <i class="pm-sep"></i>
          <span class="pm-i">关闭这块虚拟屏</span>
        </div>
        <div class="alert" data-alert style={box(alert)}>
          <AppIcon app="yomado" size={64} largest loading="eager" class="alert-icon" />
          <b>给虚拟屏命名</b>
          <p>例如 Codex 或 GrokBot。名称会显示在屏幕和菜单栏中。</p>
          <span class="alert-field"><span data-alert-text>Agent 1</span><i data-alert-caret></i></span>
          <span class="alert-buttons"><span class="ab">取消</span><span class="ab default" data-alert-save>保存</span></span>
        </div>
        <svg class="cursor panel-cursor" data-panel-pointer viewBox="0 0 22 30"><path d="M2 2v22l5.6-5.3 3.6 8.4 3.6-1.5-3.6-8.3h7.6z"></path></svg>
      </Fragment>
    </ControlPanel>
  </div>

  <!-- ===================== The frame ===================== -->
  <div class="capture" data-capture>
    <i class="c-dim"></i>
    <i class="c-sweep"></i>
    <i class="br tl"></i><i class="br tr"></i><i class="br bl"></i><i class="br brr"></i>
  </div>
  <div class="thumb" data-thumb><canvas data-thumb-canvas width="320" height="180"></canvas></div>

  <div class="keys" data-keys>
    <kbd data-key="0">3</kbd>
    <kbd data-key="1">⏎</kbd>
  </div>

  <i class="band top" data-band="top"></i>
  <i class="band bottom" data-band="bottom"></i>
  <div class="supers">
    {
      script.supers.map((text, i) => <p class="super" data-super={i} set:html={phrased(text)} />)
    }
  </div>

  <div class="end" data-end>
    <div class="mark" data-mark>
      <i class="mark-glow"></i>
      <svg viewBox="0 0 100 100">
        <defs>
          <linearGradient id={`film-${layout}-tile`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#16265e"></stop>
            <stop offset="1" stop-color="#0a1538"></stop>
