---
/**
 * The yomado story scene: your display, two named virtual screens, the apps that move between
 * them and the night-window mark. Apps appear with their own icons (src/lib/apps.ts); the windows
 * are simplified sketches of them. src/scripts/scene-view.ts poses everything from the timeline in
 * src/lib/scene.ts. Decorative: the surrounding copy carries the meaning.
 */
import AppIcon from './AppIcon.astro';
import type { AppId } from '../lib/apps';
import { MENUBAR_ICON } from '../lib/menubar';
import { ICON } from '../lib/scene';

interface Props {
  id?: string;
  class?: string;
  /** 'film' paints the sky (day to night) behind the scene; on the page the section paints it. */
  mode?: 'page' | 'film';
  /** Fix the layout instead of choosing it from the container's shape. */
  layout?: 'wide' | 'tall';
}

const { id, class: className, mode = 'page', layout } = Astro.props;

// Your Dock: the apps in the story, and yomado itself with its full night-window icon.
const dock: AppId[] = ['wechat', 'chrome', 'blender', 'md', 'yomado'];

// The ivory window of the mark, without its crescent: a large top-left radius, small elsewhere.
const { x, y, w, h, tl, br } = ICON;
const windowPath =
  `M${x} ${y + tl}A${tl} ${tl} 0 0 1 ${x + tl} ${y}H${x + w - br}A${br} ${br} 0 0 1 ${x + w} ${y + br}` +
  `V${y + h - br}A${br} ${br} 0 0 1 ${x + w - br} ${y + h}H${x + br}A${br} ${br} 0 0 1 ${x} ${y + h - br}Z`;
const uid = id ?? 'scene';
---

<div class:list={['scene', className]} id={id} data-scene data-mode={mode} data-fixed-layout={layout} aria-hidden="true">
  <div class="stage" data-stage>
    {mode === 'film' && <div class="sky"><i class="sky-dusk"></i><i class="sky-night"></i></div>}

    <!-- Your display -->
    <div class="part phys" data-part="phys">
      <div class="stand"><i class="neck"></i><i class="foot"></i><i class="contact"></i></div>
      <div class="bezel"><i class="camera"></i></div>
      <div class="screen">
        <div class="wallpaper"></div>
        <div class="menubar">
          <i class="mb-dot"></i><i class="mb-item w1"></i><i class="mb-item w2"></i><i class="mb-item w3"></i><i class="mb-item w4"></i>
          <span class="mb-right">
            <svg class="mb-yomado" viewBox={MENUBAR_ICON.viewBox}><path d={MENUBAR_ICON.path} /></svg>
            <i></i><i></i><i class="mb-clock"></i>
          </span>
        </div>
        <div class="win notes">
          <div class="tb"><i></i><i></i><i></i></div>
          <div class="notes-body">
            <div class="notes-list"><i class="on"></i><i></i><i></i><i></i></div>
            <div class="notes-page"><b></b><i></i><i></i><i class="short"></i><i></i><i class="short"></i></div>
          </div>
        </div>
        <div class="win mail">
          <div class="tb"><i></i><i></i><i></i></div>
          <div class="mail-body">
            <div class="mail-side"><i></i><i></i><i></i></div>
            <div class="mail-list">
              {[0, 1, 2, 3].map((n) => <div class:list={['row', { on: n === 0 }]}><b></b><i></i><i class="short"></i></div>)}
            </div>
            <div class="mail-read"><b></b><i></i><i></i><i class="short"></i></div>
          </div>
        </div>
        <div class="dock">
          {
            dock.map((app) => (
              <span class="tile running">
                <AppIcon app={app} size={44} />
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Virtual screens -->
    {
      (['codex', 'grok'] as const).map((s) => (
        <div class="part vscreen" data-part={s}>
          <i class="vs-sweep" />
          <i class="vs-bar" />
          <i class="vs-lit" />
        </div>
      ))
    }

    <!-- Labels: the screen's name, its resolution and the apps that live on it -->
    {
      (
        [
          ['codex', 'Codex', ['blender', 'md']],
          ['grok', 'GrokBot', ['chrome']],
        ] as const
      ).map(([s, name, apps]) => (
        <div class="part vlabel" data-part={`${s}-label`}>
          <span class="vl-name">{name}</span>
          <span class="vl-meta">1920 × 1080</span>
          <span class="vl-chips">
            {apps.map((app) => (
              <span class="chip" data-chip={app}>
                <AppIcon app={app} size={40} />
              </span>
            ))}
          </span>
        </div>
      ))
    }

    <!-- Agent apps: Blender, Marvelous Designer and Chrome, sketched -->
    <div class="part win model dark" data-part="blender">
      <div class="tb"><i></i><i></i><i></i></div>
      <div class="model-body">
        <div class="model-tools"><i></i><i class="on"></i><i></i><i></i><i></i></div>
        <div class="model-view">
          <div class="floor"></div>
          <svg class="gizmo" viewBox="0 0 40 40">
            <path class="gx" d="M20 20L33 24" /><path class="gy" d="M20 20L12 29" /><path class="gz" d="M20 20V6" />
            <circle class="gx" cx="33" cy="24" r="4" /><circle class="gy" cx="12" cy="29" r="4" /><circle class="gz" cx="20" cy="6" r="4" />
          </svg>
          <svg class="obj" viewBox="0 0 220 170">
            <ellipse class="obj-shadow" cx="96" cy="140" rx="62" ry="12"></ellipse>
            <g class="cube">
              <path class="f top" d="M96 30l52 26-52 26-52-26z"></path>
              <path class="f left" d="M44 56l52 26v58l-52-26z"></path>
              <path class="f right" d="M148 56l-52 26v58l52-26z"></path>
              <path class="edges" d="M96 30l52 26-52 26-52-26zM44 56v58l52 26 52-26V56M96 82v58"></path>
            </g>
            <g class="sphere">
              <circle cx="176" cy="118" r="22"></circle>
              <ellipse cx="170" cy="111" rx="8" ry="6"></ellipse>
            </g>
          </svg>
        </div>
        <div class="model-props"><b></b><i></i><i class="short"></i><i></i><span class="swatches"><u></u><u></u><u></u></span></div>
      </div>
      <div class="model-time"><i></i></div>
    </div>

    <div class="part win md dark" data-part="md">
      <div class="tb"><i></i><i></i><i></i></div>
      <div class="md-body">
        <div class="md-3d">
          <svg viewBox="0 0 140 240">
            <ellipse class="md-floor" cx="70" cy="226" rx="44" ry="7"></ellipse>
            <path class="md-avatar" d="M70 14a12 12 0 1 1 0 24a12 12 0 1 1 0-24zM62 40h16l3 10c12 3 20 8 21 16l-4 58-7 2-2-48-4 50-1 92h-10l-4-86-4 86h-10l-1-92-4-50-2 48-7-2-4-58c1-8 9-13 21-16z"></path>
            <path class="md-dress" d="M57 52c4 6 22 6 26 0l9 20-5 44c10 30 22 62 26 92-26 9-60 9-86 0 4-30 16-62 26-92l-5-44z"></path>
            <path class="md-fold" d="M58 128c-6 24-12 52-14 76M70 126v84M82 128c6 24 12 52 14 76"></path>
          </svg>
        </div>
        <div class="md-2d">
          <svg viewBox="0 0 200 240">
            <path class="md-piece p1" d="M18 26h46l6 44-10 6h-38l-10-6z"></path>
            <path class="md-piece p2" d="M90 26h46l6 44-10 6h-38l-10-6z"></path>
            <path class="md-piece p3" d="M28 96h48l18 120h-84z"></path>
            <path class="md-piece p4" d="M112 96h48l18 120h-84z"></path>
            <path class="md-seam" d="M64 30l6 40M136 30l6 40M76 100l18 112M160 100l18 112"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="part win chrome" data-part="chrome">
      <div class="tb">
        <i></i><i></i><i></i>
        <span class="tab"><u></u><b></b></span>
      </div>
      <div class="bar"><span class="url"></span></div>
      <i class="load"></i>
      <div class="page">
        <i class="page-hero"></i><i class="page-line"></i><i class="page-line short"></i>
        <span class="cards"><i></i><i></i><i></i></span>
      </div>
    </div>

    <!-- The night-window mark -->
    <div class="part mark" data-part="mark">
      <i class="mark-glow"></i>
      <svg viewBox="0 0 100 100">
        <defs>
          <linearGradient id={`${uid}-tile`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#16265e"></stop>
            <stop offset="1" stop-color="#0a1538"></stop>
          </linearGradient>
          <mask id={`${uid}-bite`} maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
            <rect width="100" height="100" fill="#fff"></rect>
            <circle data-bite r={ICON.r} cx="0" cy="0" fill="#000"></circle>
          </mask>
        </defs>
        <rect class="mark-tile" width="100" height="100" rx={ICON.tile} fill={`url(#${uid}-tile)`}></rect>
        <path class="mark-window" d={windowPath} mask={`url(#${uid}-bite)`}></path>
      </svg>
    </div>
    <div class="part word" data-part="word">yomado<span lang="zh-CN">夜窗</span></div>
  </div>
</div>

<style>
  .scene {
    --night: 0;
    --ivory: #fcf8e1;
    --label-ink: color-mix(in srgb, #1d1d1f calc((1 - var(--night)) * 100%), #f5f1dc);
    --label-soft: color-mix(in srgb, #6e6e73 calc((1 - var(--night)) * 100%), #9aa3c4);
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    contain: layout paint;
    pointer-events: none;
    user-select: none;
  }

  .stage {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
  }

  .part {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
  }

  /* Film only: day to night behind everything. */
  .sky {
    position: absolute;
    inset: 0;
    background: #fff;
  }

  /* Twilight peaks halfway, so day never fades to grey on the way to night. */
  .sky-dusk {
    position: absolute;
    inset: 0;
    opacity: calc(var(--dusk, 0) * 0.92);
    background: linear-gradient(180deg, #2c3c86 0%, #6f78c0 48%, #d9b7b5 82%, #f1cfb4 100%);
  }

  .sky-night {
    position: absolute;
    inset: 0;
    opacity: var(--night);
    background:
      radial-gradient(60% 55% at 50% 46%, #142454 0%, rgb(20 36 84 / 0) 70%),
      linear-gradient(180deg, #060c22 0%, #050a1c 100%);
  }

  /* ---------- Your display ---------- */
  .phys {
    width: 1000px;
    height: 625px;
  }

  .bezel {
    position: absolute;
    inset: -16px;
    border-radius: 28px;
    background: linear-gradient(180deg, #2a2a2e, #141416);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.1),
      0 2px 0 rgb(0 0 0 / 0.08),
      0 40px 80px -30px rgb(20 24 40 / 0.45);
  }

  .camera {
    position: absolute;
    top: 6px;
    left: 50%;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: #2f3640;
  }

  .stand {
    position: absolute;
    left: 50%;
    top: 609px;
    width: 0;
  }

  .neck {
    position: absolute;
    left: -64px;
    top: 0;
    width: 128px;
    height: 134px;
    background: linear-gradient(90deg, #b9bcc4, #e9eaee 35%, #d4d6dc 70%, #a7aab3);
    clip-path: polygon(8% 0, 92% 0, 100% 100%, 0 100%);
  }

  .foot {
    position: absolute;
    left: -170px;
    top: 128px;
    width: 340px;
    height: 16px;
    border-radius: 8px 8px 10px 10px;
    background: linear-gradient(180deg, #f1f2f5, #c3c6ce);
    box-shadow: inset 0 -2px 0 rgb(0 0 0 / 0.08);
  }

  .contact {
    position: absolute;
    left: -210px;
    top: 136px;
    width: 420px;
    height: 26px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(20 24 40 / 0.28), transparent);
    z-index: -1;
  }

  .screen {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 12px;
    background: #e9eef8;
  }

  .wallpaper {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 90% at 4% 0%, #c9dcff 0%, rgb(201 220 255 / 0) 62%),
      radial-gradient(80% 80% at 100% 100%, #ffd7ae 0%, rgb(255 215 174 / 0) 62%),
      radial-gradient(60% 60% at 70% 20%, #f3e9ff 0%, rgb(243 233 255 / 0) 70%),
      linear-gradient(160deg, #e6edfb, #f8efe4);
  }

  .menubar {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 14px;
    height: 24px;
    padding: 0 16px;
    background: rgb(255 255 255 / 0.55);
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.04);
  }

  .mb-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #2b2d33;
  }

  .mb-item {
    height: 7px;
    border-radius: 4px;
    background: rgb(29 29 31 / 0.55);
  }

  .w1 {
    width: 40px;
    background: rgb(29 29 31 / 0.8);
  }
  .w2 {
    width: 30px;
  }
  .w3 {
    width: 34px;
  }
  .w4 {
    width: 26px;
  }

  .mb-right {
    display: flex;
    gap: 12px;
    margin-left: auto;
  }

  .mb-right {
    align-items: center;
  }

  .mb-right i {
    width: 14px;
    height: 8px;
    border-radius: 3px;
    background: rgb(29 29 31 / 0.5);
  }

  /* yomado's single-colour menu bar icon, drawn the way macOS tints a template image. */
  .mb-yomado {
    width: 15px;
    height: 15px;
    fill: rgb(29 29 31 / 0.82);
  }

  .mb-right .mb-clock {
    width: 52px;
    background: rgb(29 29 31 / 0.65);
  }

  /* ---------- Windows ---------- */
  .win {
    position: absolute;
    overflow: hidden;
    border-radius: 12px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgb(15 23 42 / 0.1),
      0 18px 40px -12px rgb(15 23 42 / 0.32);
  }

  .part.win {
    width: 440px;
    height: 290px;
    --lift: 0;
    --work: 0;
    box-shadow:
      0 0 0 1px rgb(15 23 42 / 0.12),
      0 calc(16px + 30px * var(--lift)) calc(36px + 46px * var(--lift)) calc(-10px - 4px * var(--lift))
        rgb(10 18 48 / calc(0.34 + 0.16 * var(--lift)));
  }

  .tb {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 28px;
    padding: 0 12px;
    background: #f4f4f6;
    border-bottom: 1px solid rgb(0 0 0 / 0.07);
  }

  .tb > i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .tb > i:nth-child(2) {
    background: #febc2e;
  }

  .tb > i:nth-child(3) {
    background: #28c840;
  }

  .dark {
    background: #1f2024;
  }

  .dark .tb {
    background: #2a2b30;
    border-color: rgb(255 255 255 / 0.06);
  }

  /* Notes (yours) */
  .notes {
    left: 56px;
    top: 66px;
    width: 300px;
    height: 214px;
  }

  .notes-body {
    display: grid;
    grid-template-columns: 96px 1fr;
    height: calc(100% - 28px);
  }

  .notes-list {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 12px 10px;
    background: #f7f6f2;
    border-right: 1px solid rgb(0 0 0 / 0.06);
  }

  .notes-list i {
    height: 26px;
    border-radius: 6px;
    background: linear-gradient(rgb(29 29 31 / 0.18), rgb(29 29 31 / 0.18)) 8px 7px / 54px 5px no-repeat,
      linear-gradient(rgb(29 29 31 / 0.1), rgb(29 29 31 / 0.1)) 8px 16px / 36px 4px no-repeat;
  }

  .notes-list i.on {
    background-color: #ffe08a;
  }

  .notes-page,
  .mail-read {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 16px 16px;
  }

  .notes-page b,
  .mail-read b {
    width: 62%;
    height: 11px;
    border-radius: 5px;
    background: rgb(29 29 31 / 0.75);
  }

  .notes-page i,
  .mail-read i,
  .mail-list i {
    height: 6px;
    border-radius: 3px;
    background: rgb(29 29 31 / 0.16);
  }

  .notes-page i.short,
  .mail-read i.short,
  .mail-list i.short {
    width: 58%;
  }

  /* Mail (yours) */
  .mail {
    left: 172px;
    top: 296px;
    width: 420px;
    height: 250px;
  }

  .mail-body {
    display: grid;
    grid-template-columns: 70px 150px 1fr;
    height: calc(100% - 28px);
  }

  .mail-side {
    display: grid;
    align-content: start;
    gap: 9px;
    padding: 12px 10px;
    background: #f3f5f9;
  }

  .mail-side i {
    height: 7px;
    border-radius: 4px;
    background: rgb(36 104 236 / 0.35);
  }

  .mail-side i + i {
    background: rgb(29 29 31 / 0.14);
  }

  .mail-list {
    border-right: 1px solid rgb(0 0 0 / 0.06);
  }

  .row {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 5px 8px;
    padding: 9px 10px;
    border-bottom: 1px solid rgb(0 0 0 / 0.05);
  }

  .row b {
    grid-row: span 2;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: linear-gradient(#c9d4ea, #a9b6d3);
  }

  .row.on {
    background: #2468ec;
  }

  .row.on i {
    background: rgb(255 255 255 / 0.75);
  }

  .row.on b {
    background: rgb(255 255 255 / 0.8);
  }

  /* Dock */
  .dock {
    position: absolute;
    left: 50%;
    bottom: 12px;
    display: flex;
    gap: 9px;
    padding: 8px 10px 10px;
    border-radius: 18px;
    background: rgb(255 255 255 / 0.5);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.7),
      0 8px 24px -10px rgb(20 30 60 / 0.3);
    transform: translateX(-50%);
  }

  /* Dock items are the apps' own icons, at their own proportions. */
  .tile {
    position: relative;
    width: 44px;
    height: 44px;
  }

  .tile :global(img),
  .chip :global(img) {
    width: 100%;
    height: 100%;
  }

  .tile.running::after {
    content: '';
    position: absolute;
    bottom: -7px;
    left: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: rgb(29 29 31 / 0.55);
  }

  /* ---------- Virtual screens: night windows ---------- */
  .vscreen {
    --reveal: 0;
    --lit: 0;
    --glow: 0.35;
    width: 640px;
    height: 360px;
    overflow: hidden;
    border-radius: 14px;
    background:
      radial-gradient(90% 70% at 18% 0%, rgb(252 248 225 / 0.12), rgb(252 248 225 / 0) 60%),
      linear-gradient(180deg, #172a63 0%, #0c1840 100%);
    box-shadow:
      inset 0 0 0 1.5px rgb(252 248 225 / calc(0.25 + 0.4 * var(--reveal))),
      0 0 calc(30px + 70px * var(--glow)) calc(2px * var(--glow)) rgb(252 248 225 / calc(0.1 + 0.32 * var(--glow))),
      0 30px 60px -24px rgb(10 21 56 / 0.5);
  }

  .vs-bar {
    position: absolute;
    inset: 0 0 auto;
    height: 16px;
    background: rgb(255 255 255 / 0.06);
  }

  /* A band of light crosses the screen as it switches on. */
  .vs-sweep {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgb(252 248 225 / 0) 35%, rgb(252 248 225 / 0.45) 50%, rgb(252 248 225 / 0) 65%);
    opacity: calc(1 - var(--reveal) * var(--reveal));
    transform: translateX(calc(-110% + 220% * var(--reveal)));
  }

  .vs-lit {
    position: absolute;
    inset: 0;
    background: var(--ivory);
    opacity: var(--lit);
  }

  /* ---------- Labels ---------- */
  .vlabel {
    --name: 0;
    --meta: 0;
    display: flex;
    align-items: center;
    gap: 0.5em;
    height: 30px;
    font-size: 21px;
    line-height: 1;
    white-space: nowrap;
  }

  .vl-name {
    color: var(--label-ink);
    font-weight: 650;
    letter-spacing: -0.01em;
    clip-path: inset(-20% calc((1 - var(--name)) * 100%) -20% 0);
  }

  .vl-meta {
    color: var(--label-soft);
    font-size: 0.8em;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    opacity: var(--meta);
  }

  .vl-chips {
    display: flex;
    gap: 8px;
    margin-left: auto;
  }

  .chip {
    --pop: 0;
    width: 34px;
    height: 34px;
    opacity: var(--pop);
    transform: scale(calc(0.5 + 0.5 * var(--pop)));
  }

  .scene[data-layout='tall'] .vlabel {
    height: 40px;
    font-size: 28px;
  }

  .scene[data-layout='tall'] .chip {
    width: 44px;
    height: 44px;
  }

  /* ---------- Agent apps ---------- */
  /* 3D modelling */
  .model-body {
    display: grid;
    grid-template-columns: 34px 1fr 92px;
    height: calc(100% - 28px - 18px);
  }

  .model-tools {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 10px 8px;
    background: #26272c;
    border-right: 1px solid rgb(255 255 255 / 0.05);
  }

  .model-tools i {
    height: 18px;
    border-radius: 5px;
    background: rgb(255 255 255 / 0.1);
  }

  .model-tools i.on {
    background: #ee6f28;
  }

  .model-view {
    position: relative;
    overflow: hidden;
