---
// The control panel, rebuilt from the app's own layout with example displays and the real icons of
// the apps on each screen (src/components/ControlPanel.astro). Under it, outside the illustration:
// an agent can prepare its own screen in the real panel with the yomado skill, with a request to copy.
import ControlPanel from './ControlPanel.astro';
import CopyText from './CopyText.astro';
import { exampleCards } from '../lib/panel';
import { localeHref, type Locale } from '../lib/site';
import { SKILL_URL } from '../lib/skill';
import { phrased } from '../lib/text';
import type { Copy } from '../i18n';

interface Props {
  locale: Locale;
  copy: Copy;
}

const { locale, copy } = Astro.props;
// Codex holds the two apps the agent works in; your own apps stay on your displays.
const cards = exampleCards({ one: ['wechat'], two: ['chrome'], codex: ['blender', 'md'] });
---

<section class="panel" aria-labelledby="panel-title">
  <div class="copy wrap">
    <h2 id="panel-title" class="headline-2" set:html={phrased(copy.panel.title)} />
    <p class="sub">{copy.panel.text}</p>
  </div>
  <figure class="figure">
    <div class="scroller" tabindex="0" role="region" aria-label={copy.panel.title.replaceAll('|', '')}>
      <ControlPanel cards={cards} label={copy.panel.imageAlt} />
    </div>
    <figcaption class="fine">{copy.panel.caption}</figcaption>
  </figure>
  <div class="agent wrap" id="agent-setup">
    <p class="agent-text" set:html={copy.agent.textHtml} />
    <CopyText
      id="agent-request"
      text={copy.agent.request}
      label={copy.agent.requestLabel}
      copy={copy.details.copy}
      name={copy.agent.copyName}
      copied={copy.details.copied}
      fallback={copy.details.copyFallback}
    />
    <p class="links">
      <a class="more" href={SKILL_URL}>{copy.agent.skill}</a>
      <a class="more" href={`${localeHref(locale, 'details/')}#agent-setup`}>{copy.agent.setup}</a>
    </p>
  </div>
</section>

<style>
  .panel {
    padding-block: clamp(80px, 14vh, 160px) clamp(64px, 10vh, 120px);
    background: var(--paper);
  }

  .copy {
    display: grid;
    justify-items: center;
    gap: 12px;
    margin-bottom: clamp(32px, 6vh, 64px);
    text-align: center;
  }

  .copy .sub {
    max-width: 30ch;
  }

  :lang(zh-CN) .copy .sub,
  :lang(ja) .copy .sub {
    max-width: 22em;
  }

  .figure {
    width: min(100% - 2 * var(--gutter), 1180px);
    margin: 0 auto;
  }

  .scroller {
    overflow: hidden;
    border-radius: clamp(14px, 1.8vw, 24px);
    background: #f7f7f7;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.06),
      0 30px 70px -30px rgb(20 30 60 / 0.35);
  }

  .scroller :global(.cp-frame) {
    width: 100%;
  }

  .fine {
    margin-top: 16px;
    text-align: center;
  }

  .agent {
    display: grid;
    justify-items: center;
    gap: 18px;
    margin-top: clamp(48px, 8vh, 88px);
    text-align: center;
  }

  .agent-text {
    max-width: 36em;
    margin: 0;
    color: var(--ink-2);
    text-wrap: balance;
  }

  .agent-text :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  :lang(zh-CN) .agent-text {
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  :lang(ja) .agent-text {
    word-break: auto-phrase;
  }

  .agent :global(.copy-text) {
    --copy-bg: var(--white);
    width: min(100%, 40rem);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 28px;
    margin: 0;
  }

  /* The panel settles into place as it scrolls in, where the browser can tie motion to scroll. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .scroller {
        animation: settle linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }
    }
  }

  @keyframes settle {
    from {
      opacity: 0.35;
      transform: translateY(48px) scale(0.94);
    }
  }

  /* Phones: keep the panel legible and let it scroll sideways. */
  @media (max-width: 640px) {
    .figure {
      width: 100%;
    }

    .scroller {
      overflow-x: auto;
      margin-inline: var(--gutter);
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }

    .scroller::-webkit-scrollbar {
      display: none;
    }

    .scroller :global(.cp-frame) {
      width: 760px;
    }

    .fine {
      padding-inline: var(--gutter);
    }
  }
</style>
