---
// Acts 1–3, scrubbed by scroll: the scene pins while its three short headlines take turns.
// src/scripts/story.ts maps scroll to the story timeline. Without JavaScript the acts stack up
// above a still of the finished scene.
import Scene from './Scene.astro';
import { phrased } from '../lib/text';
import { withBase } from '../lib/site';
import type { Copy } from '../i18n';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
---

<section class="story" id="how" aria-label={copy.story.label} data-story>
  <div class="sticky">
    <ol class="acts">
      {
        copy.story.acts.map((act, i) => (
          <li class:list={['act', { 'is-active': i === 0 }]} data-act={i}>
            <h2 class="headline-2" set:html={phrased(act.title)} />
            <p class="sub">{act.text}</p>
          </li>
        ))
      }
    </ol>
    <div class="stage">
      <Scene id="story-scene" />
      <picture class="still">
        <source media="(max-width: 640px)" srcset={withBase('media/story-tall.webp')} />
        <img src={withBase('media/story-wide.webp')} alt="" width="1920" height="1080" loading="lazy" decoding="async" />
      </picture>
    </div>
  </div>
</section>

<style>
  .story {
    position: relative;
    background: #fff;
  }

  .sticky {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: clamp(8px, 2vh, 24px);
  }

  .acts {
    display: grid;
    margin: 0;
    padding: 0 var(--gutter);
    list-style: none;
    text-align: center;
  }

  .act {
    display: grid;
    justify-items: center;
    gap: 10px;
  }

  .act .sub {
    max-width: 32ch;
  }

  :lang(zh) .act .sub,
  :lang(ja) .act .sub {
    max-width: 24em;
  }

  .stage {
    position: relative;
    min-height: 0;
  }

  .stage :global(.scene) {
    position: absolute;
    inset: 0;
  }

  .still {
    display: none;
  }

  /* With JavaScript: pin the stage and let the acts take turns. */
  :global(.js) .story {
    height: 400vh;
  }

  :global(.js) .sticky {
    position: sticky;
    top: var(--header);
    height: calc(100vh - var(--header));
    height: calc(100svh - var(--header));
    padding-block: clamp(20px, 4.5vh, 56px) clamp(12px, 3vh, 36px);
  }

  :global(.js) .act {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 520ms var(--ease),
      transform 620ms var(--ease-out);
  }

  :global(.js) .act.is-active {
    opacity: 1;
    transform: none;
  }

  /* Without JavaScript: the acts in order, then a still of the finished scene. */
  :global(html:not(.js)) .acts {
    gap: 40px;
    padding-block: 64px 40px;
  }

  :global(html:not(.js)) .stage :global(.scene) {
    display: none;
  }

  :global(html:not(.js)) .still {
    display: block;
    width: min(100% - 2 * var(--gutter), 1120px);
    margin: 0 auto 64px;
  }

  :global(html:not(.js)) .still img {
    width: 100%;
    height: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .act {
      transform: none;
      transition: none;
    }
  }
</style>
