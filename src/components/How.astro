---
// "How it works", set inside the page's large lit window.
import { nightWindow } from '../lib/shape';
import { phrased } from '../lib/text';
import type { Copy } from '../i18n';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const numerals = ['i', 'ii', 'iii'];

const createCard = nightWindow(204, 50, 82, 66, { tl: 13, br: 5, r: 11 });
const moveCard = nightWindow(160, 40, 126, 92, { tl: 18, br: 6, r: 14 });
const workCard = nightWindow(54, 18, 192, 134, { tl: 24, br: 8, r: 19 });
---

<section class="how lit window-shape" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <header>
      <p class="kicker">{copy.how.kicker}</p>
      <h2 id="how-title" class="display" set:html={phrased(copy.how.title)} />
    </header>

    <ol class="steps">
      {
        copy.how.steps.map((step, i) => (
          <li class="step">
            <div class="art" aria-hidden="true">
              {i === 0 && (
                <svg viewBox="0 0 300 170">
                  <rect x="14" y="62" width="84" height="54" rx="6" fill="#0c1940" />
                  <rect x="106" y="62" width="84" height="54" rx="6" fill="#172859" />
                  <path d="M24 70h28M116 70h28" stroke="#fcf8e1" stroke-opacity="0.22" stroke-width="2" stroke-linecap="round" />
                  <path d="M245 34v10" stroke="#0c1940" stroke-width="1.4" stroke-dasharray="2 3" />
                  <path d={createCard} fill="#fffdf4" stroke="#0c1940" stroke-width="1.5" />
                  <circle cx="245" cy="22" r="11" fill="#0c1940" />
                  <path d="M245 16.5v11M239.5 22h11" stroke="#fcf8e1" stroke-width="1.8" stroke-linecap="round" />
                  <text x="245" y="138" text-anchor="middle" class="tag">Codex</text>
                </svg>
              )}
              {i === 1 && (
                <svg viewBox="0 0 300 170">
                  <defs>
                    <marker id="how-arrow" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                      <path d="M1 1l7 4-7 4" fill="none" stroke="#0c1940" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </marker>
                  </defs>
                  <rect x="14" y="54" width="120" height="76" rx="7" fill="#0c1940" />
                  <rect x="28" y="68" width="13" height="13" rx="3.5" fill="#fcf8e1" fill-opacity="0.32" />
                  <rect x="47" y="68" width="13" height="13" rx="3.5" fill="#fcf8e1" fill-opacity="0.32" />
                  <rect x="66" y="68" width="13" height="13" rx="3.5" fill="#fcf8e1" fill-opacity="0.32" />
                  <rect x="85.5" y="68.5" width="12" height="12" rx="3.5" fill="none" stroke="#fcf8e1" stroke-opacity="0.5" stroke-dasharray="2 2.5" />
                  <path d={moveCard} fill="#fffdf4" stroke="#0c1940" stroke-width="1.5" />
                  <rect x="178" y="60" width="16" height="16" rx="4.5" fill="#df9a4c" />
                  <path d="M92 62C108 14 160 10 180 52" fill="none" stroke="#0c1940" stroke-width="1.4" stroke-dasharray="3 4" marker-end="url(#how-arrow)" />
                </svg>
              )}
              {i === 2 && (
                <svg viewBox="0 0 300 170">
                  <path d={workCard} fill="#fffdf4" stroke="#0c1940" stroke-width="1.5" />
                  <rect x="80" y="50" width="122" height="80" rx="6" fill="#161e48" />
                  <path d="M86 50h110a6 6 0 0 1 6 6v6H80v-6a6 6 0 0 1 6-6z" fill="#222c5e" />
                  <circle cx="88" cy="56" r="2" fill="#ec7b69" />
                  <circle cx="95" cy="56" r="2" fill="#efc566" />
                  <circle cx="102" cy="56" r="2" fill="#76c38b" />
                  <path d="M129 82h20v20h-20zM129 82l8-6h20l-8 6M149 82l8-6v20l-8 6" fill="none" stroke="#f2b56f" stroke-width="1.2" stroke-linejoin="round" />
                  <path d="M42 22V8h14M244 8h14v14M258 148v14h-14M56 162H42v-14" fill="none" stroke="#0c1940" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  <circle cx="150" cy="100" r="10" fill="none" stroke="#df9a4c" stroke-width="1.4" />
                  <path d="M150 100v13l3.5-3.1 2.4 5.2 2.2-.9-2.3-5.1h4.6z" fill="#fffcef" stroke="#0c1940" stroke-width="1" stroke-linejoin="round" />
                </svg>
              )}
            </div>
            <p class="numeral" aria-hidden="true">{numerals[i]}.</p>
            <h3>{step.title}</h3>
            <p class="text" set:html={step.textHtml} />
          </li>
        ))
      }
    </ol>

    <p class="note"><strong>{copy.how.noteTitle}</strong> {copy.how.noteText}</p>
  </div>
</section>

<style>
  .how {
    --r: clamp(54px, 9vw, 128px);
    --tl: clamp(40px, 8vw, 120px);
    --br: clamp(14px, 2vw, 24px);
    width: min(100% - clamp(12px, 3vw, 40px), 1440px);
    margin-inline: auto;
    padding-block: clamp(64px, 9vw, 128px) clamp(56px, 7vw, 96px);
  }

  header {
    padding-right: calc(var(--r) * 1.4);
  }

  h2 {
    max-width: 17em;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 56px);
    margin-top: clamp(48px, 6vw, 80px);
    list-style: none;
  }

  .step {
    padding-top: 22px;
    border-top: 1px solid rgb(12 25 64 / 0.16);
  }

  .art svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .tag {
    fill: var(--ink-soft);
    font: 400 11px var(--font-mono);
    letter-spacing: 0.04em;
  }

  .numeral {
    margin-top: 22px;
    color: var(--ink-faint);
    font: italic 300 2.1rem/1 var(--font-display);
  }

  h3 {
    margin-top: 12px;
    font: 600 1.2rem/1.3 var(--font-sans);
    letter-spacing: -0.005em;
  }

  .text {
    margin-top: 10px;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .note {
    max-width: 64rem;
    margin-top: clamp(48px, 6vw, 72px);
    padding-top: 22px;
    border-top: 1px solid rgb(12 25 64 / 0.16);
    color: var(--ink-faint);
    font-size: 0.9375rem;
  }

  .note strong {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      max-width: 34rem;
    }

    .art {
      max-width: 320px;
    }
  }
</style>
